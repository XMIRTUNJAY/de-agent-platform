{
  "name": "de-agent-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Data Engineering for the Agent Era — learning roadmap + agent-native skills/MCP marketplace.",
  "scripts": {
    "pipeline": "node pipelines/run.mjs",
    "pipeline:check": "node pipelines/run.mjs --check",
    "discover": "node pipelines/discover.mjs",
    "discover:dry": "node pipelines/discover.mjs --dry",
    "dev": "node pipelines/run.mjs && astro dev",
    "build": "node pipelines/run.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "serve": "astro preview --host"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.6",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "astro": "^5.14.1",
    "fast-xml-parser": "^5.11.2",
    "tailwindcss": "^4.1.14",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/typography": "^0.5.20",
    "typescript": "^5.9.3"
  }
}
