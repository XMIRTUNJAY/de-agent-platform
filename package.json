{
  "name": "de-agent-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Data Engineering for the Agent Era — learning roadmap + agent-native skills/MCP marketplace.",
  "scripts": {
    "pipeline": "node pipelines/run.mjs",
    "pipeline:check": "node pipelines/run.mjs --check",
    "discover": "node pipelines/discover.mjs",
    "discover:dry": "node pipelines/discover.mjs --dry",
    "dev": "node pipelines/run.mjs && astro dev",
    "build": "npm run packages:build && node pipelines/run.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "serve": "astro preview --host",
    "packages:build": "npm run build --workspaces --if-present"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "vite": "6.4.4"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.6",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/vercel": "^8.2.11",
    "@de-agent/analytics": "^0.1.0",
    "@de-agent/registry-core": "^0.1.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@octokit/rest": "^22.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "astro": "^5.14.1",
    "fast-xml-parser": "^5.11.2",
    "marked": "^18.1.1",
    "tailwindcss": "^4.1.14",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0",
  "bin": {
    "de-agent": "bin/de-agent.mjs",
    "de-agent-platform": "bin/de-agent.mjs"
  },
  "files": [
    "bin/",
    "src/lib/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/XMIRTUNJAY/de-agent-platform.git"
  }
}
