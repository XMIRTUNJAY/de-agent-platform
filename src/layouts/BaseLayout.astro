---
import '@/styles/global.css';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/instrument-serif';
import '@fontsource-variable/inter';

import TopBar from '@/components/TopBar.astro';
import SidebarNav from '@/components/SidebarNav.astro';
import Footer from '@/components/Footer.astro';
import Backdrop from '@/components/Backdrop.astro';
import { SITE } from '@/site.config';
import { ANALYTICS } from '@/site.config';

interface Props {
  title?: string;
  description?: string;
  sidebar?: boolean;
  ogType?: string;
  keywords?: string[];
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  // Persistent shell: every page except the landing home carries the left
  // rail so the frame never jumps between routes (audit P1-1).
  sidebar = true,
  ogType = 'website',
  keywords = [],
  noindex = false,
} = Astro.props;

const pageTitle = title
  ? (title.includes(SITE.name) ? title : `${title} · ${SITE.name}`)
  : `${SITE.name} · ${SITE.longName}`;
// Canonical home is emanisha.in/de-agent on EVERY build (Vercel + static):
// ranking consolidates on the money domain; Vercel also carries noindex.
// Override with DEAGENT_CANONICAL only if the strategy ever changes.
const canonBase = (process.env.DEAGENT_CANONICAL ?? 'https://emanisha.in/de-agent').replace(/\/+$/, '');
const canonPath = Astro.url.pathname.replace(/^\/de-agent/, '') || '/';
const canonical = canonBase + (canonPath === '/' ? '/' : canonPath);
const ogImage = canonBase + '/og.svg';
// Noindex whenever running on Vercel (the money pages live on emanisha.in;
// Vercel is the interactive app, never the indexed copy). VERCEL=1 is set by
// Vercel itself at build AND runtime — no dashboard variable needed.
const envNoindex = process.env.DEAGENT_NOINDEX === '1' || process.env.VERCEL === '1';

// Analytics config - read from env or config
const analyticsEndpoint = import.meta.env.PUBLIC_ANALYTICS_ENDPOINT || '/api/analytics/collect';
const analyticsEnabled = import.meta.env.PUBLIC_ANALYTICS_ENABLED === 'true';
---
<!doctype html>
<html lang={SITE.locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('de-theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          }
          document.documentElement.setAttribute('data-theme', t);
          // desktop rail collapse preference — applied pre-paint (no FOUC)
          if (localStorage.getItem('de-sidebar') === 'collapsed') {
            document.documentElement.setAttribute('data-sidebar', 'collapsed');
          }
        } catch (e) { /* keep default */ }
      })();
      // Platform-aware shortcut hints (audit P3: ⌘K assumed Mac)
      (function () {
        var mac = /Mac|iPhone|iPad/i.test(navigator.platform || navigator.userAgent);
        document.documentElement.setAttribute('data-platform', mac ? 'mac' : 'other');
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonical} />
    {noindex || envNoindex ? <meta name="robots" content="noindex,follow" /> : null}
    {ANALYTICS.provider && ANALYTICS.script && <script async defer data-domain={ANALYTICS.domain} src={ANALYTICS.script}></script>}

    {analyticsEnabled && (
      <script is:inline>
        (function () {
          window.__DE_ANALYTICS_CONFIG__ = {
            endpoint: '/api/analytics/collect',
            batchSize: 10,
            flushInterval: 5000,
          };
        })();
      </script>
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — newest resources`} href={new URL('/rss.xml', Astro.site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b0d0b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafaf8" media="(prefers-color-scheme: light)" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Backdrop />
    <TopBar />
    {sidebar && <div id="sidebar-scrim" class="sidebar-scrim" aria-hidden="true"></div>}
    <div class="mx-auto flex max-w-[1600px]">
      {sidebar && <SidebarNav />}
      <main id="main" class="min-w-0 flex-1">
        <slot />
      </main>
    </div>
    <Footer />

    <script is:inline>
      (function () {
        // theme toggle
        document.addEventListener('click', function (e) {
          var t = e.target.closest('[data-theme-toggle]');
          if (!t) return;
          var cur = document.documentElement.getAttribute('data-theme') || 'dark';
          var next = cur === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('de-theme', next); } catch (err) {}
          document.querySelectorAll('[data-theme-icon]').forEach(function (ic) {
            ic.classList.toggle('hidden', ic.getAttribute('data-theme-icon') !== next);
          });
        });
        // sync icons on load
        var cur = document.documentElement.getAttribute('data-theme') || 'dark';
        document.querySelectorAll('[data-theme-icon]').forEach(function (ic) {
          ic.classList.toggle('hidden', ic.getAttribute('data-theme-icon') !== cur);
        });

        // nav toggle — drawer on mobile, rail collapse on desktop; one button
        var sb = document.getElementById('sidebar');
        var scrim = document.getElementById('sidebar-scrim');
        var toggle = document.querySelector('[data-sidebar-toggle]');
        var DESKTOP_MIN = 1024;
        function isDesktop() { return window.innerWidth >= DESKTOP_MIN; }
        function railVisible() {
          return document.documentElement.getAttribute('data-sidebar') !== 'collapsed';
        }
        function syncToggleUi(navOpen) {
          if (!toggle) return;
          // navOpen: mobile drawer open OR desktop rail visible
          toggle.setAttribute('aria-expanded', String(navOpen));
          toggle.setAttribute('aria-label', navOpen ? 'Close navigation' : 'Open navigation');
          toggle.querySelectorAll('[data-sidebar-icon]').forEach(function (ic) {
            ic.classList.toggle('hidden', ic.getAttribute('data-sidebar-icon') === (navOpen ? 'closed' : 'open'));
          });
        }
        function setSidebar(open) {
          if (!sb) return;
          sb.classList.toggle('open', open);
          if (scrim) scrim.classList.toggle('visible', open);
          syncToggleUi(open);
          // visibility:hidden (CSS) removes the closed drawer from the a11y
          // tree and tab order; focus management here.
          if (open) {
            var first = sb.querySelector('a');
            if (first) first.focus();
          } else if (document.activeElement && sb.contains(document.activeElement) && toggle) {
            toggle.focus();
          }
        }
        function setRail(visible) {
          if (visible) {
            document.documentElement.removeAttribute('data-sidebar');
          } else {
            document.documentElement.setAttribute('data-sidebar', 'collapsed');
          }
          try { localStorage.setItem('de-sidebar', visible ? 'expanded' : 'collapsed'); } catch (err) {}
          syncToggleUi(visible);
        }
        if (toggle) toggle.addEventListener('click', function () {
          if (isDesktop()) setRail(!railVisible());
          else setSidebar(!sb.classList.contains('open'));
        });
        if (scrim) scrim.addEventListener('click', function () { setSidebar(false); });
        // keep state coherent when the viewport crosses the breakpoint
        window.addEventListener('resize', function () {
          if (isDesktop()) { sb?.classList.remove('open'); scrim?.classList.remove('visible'); syncToggleUi(railVisible()); }
        });
        // initial state: desktop respects the persisted rail preference
        syncToggleUi(isDesktop() ? railVisible() : false);

        // Command Palette
        var palette = document.getElementById('cmd-palette');
        var paletteInput = palette?.querySelector('.cmd-input');
        var paletteResults = document.getElementById('cmd-results');
        var paletteOpen = false;

        function openPalette() {
          if (!palette || paletteOpen) return;
          paletteOpen = true;
          palette.classList.add('open');
          paletteInput?.focus();
          document.body.style.overflow = 'hidden';
          renderResults('');
        }
        function closePalette() {
          if (!palette || !paletteOpen) return;
          paletteOpen = false;
          palette.classList.remove('open');
          document.body.style.overflow = '';
        }

        document.addEventListener('click', function (e) {
          var t = e.target.closest('[data-cmd-palette-open]');
          if (t) { openPalette(); return; }
          if (paletteOpen && !palette.contains(e.target)) closePalette();
        });
        document.addEventListener('keydown', function (e) {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            if (paletteOpen) closePalette(); else openPalette();
          }
          if (e.key === 'Escape') {
            if (paletteOpen) closePalette();
            setSidebar(false);
          }
          if (e.key === '/' && !/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName) && !document.activeElement.isContentEditable) {
            e.preventDefault();
            openPalette();
          }
        });

        function renderResults(query) {
          if (!paletteResults) return;
          var q = (query || '').trim().toLowerCase();
          var registry = window.__DE_REGISTRY__ || [];
          var results = registry
            .map(function(r) {
              var hay = (r.title + ' ' + (r.tagline || '') + ' ' + (r.description || '') + ' ' + (r.tags || []).join(' ') + ' ' + (r.categoryTitle || '')).toLowerCase();
              var terms = q.split(/\s+/).filter(Boolean);
              var score = 0;
              for (var i = 0; i < terms.length; i++) {
                if (r.title.toLowerCase().includes(terms[i])) score += 10;
                if (r.tags?.some(function(tag) { return tag.toLowerCase().includes(terms[i]); })) score += 5;
                if (hay.includes(terms[i])) score += 1;
              }
              return { r: r, score: score };
            })
            .filter(function(x) { return x.score > 0; })
            .sort(function(a,b) { return b.score - a.score; })
            .slice(0, 10);

          if (!results.length) {
            paletteResults.innerHTML = '<div class="px-4 py-8 text-center text-dim">No matches for "' + q + '"</div>';
            return;
          }
          paletteResults.innerHTML = results.map(function(x) {
            var r = x.r;
            var verificationLabel = r.verification === 'verified' ? '✓ Verified' : r.verification === 'tested' ? '✓ Tested' : r.verification === 'reviewed' ? '✓ Reviewed' : 'Community';
            var verificationColor = r.verification === 'verified' ? 'accent' : r.verification === 'tested' ? 'info' : r.verification === 'reviewed' ? 'warn' : 'dim';
            return '<div class="cmd-item" data-url="' + r.url + '" role="option" tabindex="0">' +
              '<span class="chip">' + r.typeLabel + '</span>' +
              '<span class="flex-1 min-w-0 truncate">' + r.title + '</span>' +
              '<span class="chip" style="color: var(--color-' + verificationColor + ')">' + verificationLabel + '</span>' +
              '<kbd class="kbd ml-auto">Enter</kbd>' +
            '</div>';
          }).join('');

          // keyboard navigation
          var items = paletteResults.querySelectorAll('.cmd-item');
          var selected = 0;
          items.forEach(function(item, i) {
            item.addEventListener('click', function() {
              window.location.href = item.dataset.url;
              closePalette();
            });
            item.addEventListener('keydown', function(ev) {
              if (ev.key === 'Enter') {
                window.location.href = item.dataset.url;
                closePalette();
              } else if (ev.key === 'ArrowDown') {
                ev.preventDefault();
                items[(i + 1) % items.length]?.focus();
              } else if (ev.key === 'ArrowUp') {
                ev.preventDefault();
                items[(i - 1 + items.length) % items.length]?.focus();
              }
            });
          });
          if (items.length) items[0].focus();
        }

        if (paletteInput) {
          paletteInput.addEventListener('input', function() { renderResults(this.value); });
        }

        // registry data for command palette
        fetch('/data/generated/search-index.json')
          .then(function(r) { return r.json(); })
          .then(function(d) { window.__DE_REGISTRY__ = d.entries || []; })
          .catch(function() {});

        // outbound-click hook: bounded in-memory log, no network, no cookies.
        window.__DE_OUTBOUND__ = [];
        document.addEventListener('click', function (ev) {
          var a = ev.target && ev.target.closest ? ev.target.closest('a[href^="http"]') : null;
          if (!a) return;
          window.__DE_OUTBOUND__.push({ href: a.href, at: new Date().toISOString() });
          if (window.__DE_OUTBOUND__.length > 100) window.__DE_OUTBOUND__.shift();
        });

        // Scroll-triggered reveal animations
        if ('IntersectionObserver' in window) {
          var revealObserver = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                revealObserver.unobserve(entry.target);
              }
            });
          }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

          document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale').forEach(function(el) {
            revealObserver.observe(el);
          });
        }

        // Analytics initialization
        if (window.__DE_ANALYTICS_CONFIG__) {
          var config = window.__DE_ANALYTICS_CONFIG__;
          var queue = [];
          var sessionId = sessionStorage.getItem('de_agent_session_id') || crypto.randomUUID();
          sessionStorage.setItem('de_agent_session_id', sessionId);
          var anonymousId = localStorage.getItem('de_agent_anonymous_id') || crypto.randomUUID();
          localStorage.setItem('de_agent_anonymous_id', anonymousId);

          function flush() {
            if (!queue.length) return;
            var events = queue.splice(0, config.batchSize);
            fetch(config.endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ events, version: '1.0.0' }),
              keepalive: true,
            }).catch(function() { queue.unshift.apply(queue, events); });
          }

          window.trackEvent = function(event, properties) {
            var base = {
              session_id: sessionId,
              anonymous_id: anonymousId,
              context: {
                user_agent: navigator.userAgent,
                locale: navigator.language,
                timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
                screen_width: screen.width,
                screen_height: screen.height,
              },
              page: {
                path: window.location.pathname,
                referrer: document.referrer || undefined,
                title: document.title,
              },
            };
            var fullEvent = Object.assign({}, base, { event, timestamp: new Date().toISOString(), properties });
            queue.push(fullEvent);
            if (queue.length >= config.batchSize) flush();
          };

          setInterval(flush, config.flushInterval);
          window.addEventListener('beforeunload', flush);
        }
      })();
    </script>
  </body>
</html>