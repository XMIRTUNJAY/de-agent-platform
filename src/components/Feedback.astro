---
interface Props {
  resourceId: string;
  resourceTitle: string;
}
const { resourceId, resourceTitle } = Astro.props;
---

<div class="feedback-card card card-pad mt-8" id="feedback">
  <h3 class="text-lg font-medium mb-4">Did this solve your problem?</h3>
  <p class="text-sm text-dim mb-4">{resourceTitle}</p>

  <div class="feedback-buttons flex gap-3 mb-4" role="group" aria-label="Feedback options">
    <button
      type="button"
      class="feedback-btn btn btn-accent"
      data-feedback="yes"
      aria-label="Yes, this solved my problem"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
      <span>Yes</span>
    </button>
    <button
      type="button"
      class="feedback-btn btn btn-ghost"
      data-feedback="partial"
      aria-label="Partially helpful"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
      </svg>
      <span>Partially</span>
    </button>
    <button
      type="button"
      class="feedback-btn btn btn-ghost"
      data-feedback="no"
      aria-label="No, this didn't help"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
      <span>No</span>
    </button>
  </div>

  <div class="feedback-comment hidden" id="feedback-comment">
    <label for="feedback-text" class="block text-sm text-dim mb-2">What could be improved? (optional)</label>
    <textarea
      id="feedback-text"
      class="w-full px-3 py-2 border rounded bg-base-200 text-sm resize-none"
      rows="3"
      maxlength="2000"
      placeholder="Your feedback helps us improve..."
    ></textarea>
    <div class="flex justify-end gap-2 mt-3">
      <button type="button" class="btn btn-ghost feedback-cancel">Cancel</button>
      <button type="button" class="btn btn-accent feedback-submit" disabled>Submit</button>
    </div>
  </div>

  <div class="feedback-thanks hidden text-center py-8" id="feedback-thanks">
    <svg class="w-12 h-12 mx-auto text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
    <p class="mt-3 text-dim">Thanks! Your feedback helps us improve.</p>
  </div>
</div>

<script>
  (function () {
    const card = document.getElementById('feedback');
    if (!card) return;

    const resourceId = '{resourceId}';
    const buttons = card.querySelectorAll('.feedback-btn');
    const commentSection = card.querySelector('#feedback-comment');
    const commentText = card.querySelector('#feedback-text');
    const submitBtn = card.querySelector('.feedback-submit');
    const cancelBtn = card.querySelector('.feedback-cancel');
    const thanksSection = card.querySelector('#feedback-thanks');

    let selectedFeedback: 'yes' | 'partial' | 'no' | null = null;

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        selectedFeedback = btn.dataset.feedback as 'yes' | 'partial' | 'no';
        buttons.forEach(b => {
          b.classList.toggle('btn-accent', b.dataset.feedback === selectedFeedback);
          b.classList.toggle('btn-ghost', b.dataset.feedback !== selectedFeedback);
        });
        commentSection?.classList.remove('hidden');
        commentText?.focus();
        updateSubmitState();
      });
    });

    commentText?.addEventListener('input', updateSubmitState);

    function updateSubmitState() {
      if (submitBtn) {
        submitBtn.disabled = !selectedFeedback;
      }
    }

    submitBtn?.addEventListener('click', async () => {
      if (!selectedFeedback) return;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';

      try {
        const res = await fetch('/api/feedback', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            resource_id: resourceId,
            helpful: selectedFeedback,
            comment: commentText?.value?.trim() || undefined,
          }),
        });

        if (res.ok) {
          showThanks();
          trackFeedbackEvent(selectedFeedback, !!commentText?.value?.trim());
        } else {
          throw new Error('Failed');
        }
      } catch (err) {
        console.error('Feedback submit failed:', err);
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit';
        alert('Failed to submit feedback. Please try again.');
      }
    });

    cancelBtn?.addEventListener('click', () => {
      selectedFeedback = null;
      buttons.forEach(b => {
        b.classList.remove('btn-accent');
        b.classList.add('btn-ghost');
      });
      commentSection?.classList.add('hidden');
      commentText!.value = '';
      updateSubmitState();
    });

    function showThanks() {
      buttons.forEach(b => b.disabled = true);
      commentSection?.classList.add('hidden');
      thanksSection?.classList.remove('hidden');
    }

    function trackFeedbackEvent(helpful: string, hasComment: boolean) {
      if (window.trackEvent) {
        window.trackEvent('feedback_submit', {
          resource_id: resourceId,
          helpful,
          has_comment: hasComment,
        });
      }
    }
  })();
</script>

<style>
  .feedback-btn { transition: all 0.15s ease; }
  .feedback-btn[data-feedback="yes"].btn-accent { background-color: var(--color-accent); }
  .feedback-btn[data-feedback="partial"].btn-accent { background-color: var(--color-info); }
  .feedback-btn[data-feedback="no"].btn-accent { background-color: var(--color-danger); }
  .feedback-comment textarea:focus { outline: none; border-color: var(--color-accent); }
  .feedback-thanks svg { animation: pop-in 0.3s ease-out; }
  @keyframes pop-in {
    from { transform: scale(0); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
</style>