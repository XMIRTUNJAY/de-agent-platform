---
import { TOP_NAV, SITE, NAV_SECTION_MAP } from '@/site.config';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');

// Section-aware active state: detail pages (/skills/sql-review) highlight
// their owning nav entry instead of leaving the header contextless (audit P2).
const sectionHref = NAV_SECTION_MAP.find(([prefix]) => path.startsWith(prefix))?.[1];
const activeHref = TOP_NAV.find((item) => isActive(item.href))?.href ?? sectionHref;
const activeSection = TOP_NAV.find((item) => item.href === activeHref);
---
<header
  class="sticky top-0 z-40 border-b border-line backdrop-blur-sm"
  style="background: color-mix(in oklab, var(--shell) 88%, transparent);"
>
  <div class="mx-auto flex h-14 max-w-[1600px] items-center gap-3 px-4 sm:px-6">
    <!-- nav toggle: same breadcrumb symbol opens/closes the drawer on mobile
         and collapses/expands the rail on desktop (aria-expanded reflects both) -->
    <button
      type="button"
      data-sidebar-toggle
      class="btn-ghost -ml-1 grid h-9 w-9 place-items-center rounded-md"
      aria-label="Toggle navigation" aria-expanded="false"
    >
      <svg data-sidebar-icon="closed" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round"/></svg>
      <svg data-sidebar-icon="open" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m6 6 12 12M18 6 6 18" stroke-linecap="round"/></svg>
    </button>

    <a href="/" class="flex items-center gap-2 rounded-md pr-2" aria-label={`${SITE.name} home`}>
      <Logo />
    </a>

    <!-- Full nav at lg+ only: at md (768px) the 4-6 items + right cluster
         overflowed by 54px on every page (audit P0-2). -->
    <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Main navigation">
      {TOP_NAV.map((item) => (
        <a
          href={item.href}
          class:list={[
            'flex items-center gap-1.5 rounded-md px-2.5 py-1.5 font-mono text-sm transition-colors',
            activeSection?.href === item.href ? 'text-fg bg-surface-2' : 'text-muted hover:text-fg hover:bg-surface-2',
          ]}
          aria-current={activeSection?.href === item.href ? 'page' : undefined}
        >
          <Icon name={item.icon ?? 'docs'} size={15} />
          {item.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <button
        type="button"
        data-cmd-palette-open
        class="btn btn-sm gap-1.5 text-muted"
        aria-label="Open command palette"
        title="Open command palette (Ctrl/⌘K)"
      >
        <Icon name="search" size={14} />
        <span class="hidden xl:inline">Search</span>
        <span class="hidden items-center gap-0.5 xl:inline-flex">
          <kbd class="kbd" data-platform-hint>
            <span class="kbd-mac">⌘K</span>
            <span class="kbd-other">Ctrl K</span>
          </kbd>
        </span>
      </button>

      <button
        type="button"
        data-theme-toggle
        class="btn-ghost grid h-9 w-9 place-items-center rounded-md"
        aria-label="Toggle color theme"
        title="Toggle theme"
      >
        <svg data-theme-icon="dark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linejoin="round"/></svg>
        <svg data-theme-icon="light" class="hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19" stroke-linecap="round"/></svg>
      </button>

      <a href={SITE.repo} target="_blank" rel="noopener" class="btn-ghost hidden h-9 w-9 place-items-center rounded-md sm:grid" aria-label="Source repository">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2A10 10 0 0 0 8.8 21.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10 10 0 0 0 12 2Z"/></svg>
      </a>

      <a href="/marketplace" class="btn btn-sm btn-accent">Explore</a>
    </div>
  </div>
</header>

<!-- Command Palette -->
<div class="cmd-palette" id="cmd-palette" role="dialog" aria-modal="true" aria-label="Command palette">
  <div class="p-4 border-b border-line">
    <input
      type="search"
      class="cmd-input"
      placeholder="Type a command or search..."
      aria-label="Command palette search"
      autocomplete="off"
      spellcheck="false"
    />
  </div>
  <div class="cmd-results" id="cmd-results" role="listbox"></div>
  <div class="px-4 py-2 border-t border-line text-xs text-dim font-mono">
    <kbd class="kbd"><span class="kbd-mac">⌘K</span><span class="kbd-other">Ctrl K</span></kbd> to open · <kbd class="kbd">↑</kbd><kbd class="kbd">↓</kbd> to navigate · <kbd class="kbd">Enter</kbd> to select · <kbd class="kbd">Esc</kbd> to close
  </div>
</div>
