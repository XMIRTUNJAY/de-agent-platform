---
import { FOOTER_COLUMNS, SITE } from '@/site.config';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-line">
  <div class="mx-auto max-w-[1600px] px-4 py-12 sm:px-6">
    <div class="grid gap-10 md:grid-cols-[1.4fr_repeat(4,1fr)]">
      <div class="max-w-xs">
        <Logo />
        <p class="mt-3 text-sm leading-relaxed text-muted">
          {SITE.description}
        </p>
        <p class="mono-label mt-4">Learn · Build · Install · Operate</p>
      </div>
      {FOOTER_COLUMNS.map((col) => (
        <div>
          <p class="mono-label pb-2">{col.title}</p>
          <ul class="space-y-1.5">
            {col.items.map((it) => (
              <li>
                {it.badge === 'soon' ? (
                  <span class="text-sm text-muted opacity-50 cursor-default" aria-disabled="true">
                    {it.label} <span class="font-mono text-2xs">(soon)</span>
                  </span>
                ) : (
                  <a
                    href={it.href}
                    target={it.external ? '_blank' : undefined}
                    rel={it.external ? 'noopener' : undefined}
                    class="text-sm text-muted transition-colors hover:text-fg"
                  >{it.label}</a>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-10 flex flex-col gap-3 border-t border-line pt-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono text-2xs text-dim">
        © {year} {SITE.name} · Registry data retains upstream provenance & license.
      </p>
      <p class="font-mono text-2xs text-dim">
        No fabricated verification. Every status links to its evidence.
      </p>
    </div>
  </div>
</footer>