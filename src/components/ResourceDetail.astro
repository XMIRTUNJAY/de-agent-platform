---
import Feedback from '@/components/Feedback.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ArchitectureCanvas from '@/components/diagrams/ArchitectureCanvas.astro';
import { marked } from 'marked';

// Resource bodies are human-gated curated YAML — trusted input, rendered
// server-side with GFM so tables/checklists in skill docs work.
marked.setOptions({ gfm: true, breaks: false });

const { res, registry, trustScan = null } = Astro.props as { res: any; registry: any; trustScan?: any };

const techs = res.technologies?.map((t: any) => registry.taxonomy.technologies.find((x: any) => x.id === t)).filter(Boolean) ?? [];
const prereqs = res.prerequisites?.map((id: any) => registry.resources.find((r: any) => r.id === id)).filter(Boolean) ?? [];

/** documented limitations across all types (arrays or single strings), flattened */
const limitations = [res.when_not, res.tradeoffs, res.security_notes, res.note]
  .flatMap((v: any) => (Array.isArray(v) ? v : v ? [v] : []))
  .filter(Boolean);

/** stage lookup keyed by stage id */
const stageById = registry.taxonomy.stagesById as Record<string, { title: string }>;

/** resource relationship groups (rel name -> resource ids) */
const relationships = Object.entries((res.relationships ?? {}) as Record<string, any[]>);

/** marketplace data */
const mp = res.marketplace;
const qualityScores = mp?.quality_scores ?? {};
const compositeScore = mp?.composite_score ?? 0;
const compositeLabel = mp?.composite_label ?? 'unproven';
const ratingAvg = mp?.rating_average ?? 0;
const ratingCount = mp?.rating_count ?? 0;
const installCount = mp?.install_count ?? 0;
const installSuccessRate = mp?.install_success_rate ?? 0;

/** score color helper */
const scoreColor = (score: number) => {
  if (score >= 80) return 'accent';
  if (score >= 65) return 'info';
  if (score >= 45) return 'warn';
  if (score >= 25) return 'danger';
  return 'dim';
};
---

<BaseLayout title={res.title} sidebar noindex={(res.page_eligibility?.state ?? 'eligible') !== 'eligible'}>
  <main class="mx-auto max-w-[1600px] px-4 py-8 sm:px-6">
    <div class="mb-6">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: registry.taxonomy.categories.find((c: any) => c.id === res.category)?.title ?? res.categoryTitle ?? 'Registry', href: res.categorySlug ? `/categories/${res.categorySlug}` : undefined },
          { label: res.title },
        ].filter((c: any) => c.href || c.label === res.title)}
      />
    </div>

    <header class="mb-8 mount">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="chip">{res.typeLabel}</span>
        {res.evidence_summary && res.evidence_summary.gap > 0 ? (
          <span class="chip" style="color: var(--color-dim)" title={`Claimed ${res.verification}; evidence on file supports ${res.evidence_summary.earned}`}>evidence: {res.evidence_summary.earned} · claimed {res.verification}</span>
        ) : (
          <span class="chip" style="color: var(--color-{res.verification === 'verified' ? 'accent' : res.verification === 'tested' ? 'info' : res.verification === 'reviewed' ? 'warn' : 'dim'})">{res.verification}</span>
        )}
        {res.difficulty && <span class="chip">{res.difficulty}</span>}
        {res.severity && (
          <span
            class="chip severity-chip"
            data-severity={res.severity}
            title={`Incident severity: ${res.severity}`}
          >
            {res.severity === 'critical' ? (
              <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2 2 21h20L12 2Zm0 7v6m0 3v.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            ) : (
              <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 8v5m0 3v.5" stroke-linecap="round" />
              </svg>
            )}
            severity: {res.severity}
          </span>
        )}
      </div>
      <h1 class="display text-3xl sm:text-4xl">{res.title}</h1>
      {res.tagline && <p class="mt-2 text-muted">{res.tagline}</p>}
      <p class="mt-3 max-w-3xl">{res.description}</p>

      {res.type === 'architecture' && (
        <div class="mt-5">
          <ArchitectureCanvas />
        </div>
      )}

      {res.install_command && (
        <div class="mt-4 codeblock">
          <pre><code class="language-bash">{res.install_command}</code></pre>
          <button class="copy-btn btn btn-sm btn-ghost" onclick="navigator.clipboard.writeText(this.previousElementSibling.innerText)">Copy</button>
        </div>
      )}
    </header>

    <div class="grid grid-cols-[minmax(0,1fr)] gap-8 min-[1200px]:grid-cols-[minmax(0,1fr)_320px]">
      <!-- min-w-0: grid item's automatic minimum would otherwise be sized by
           unbroken code lines and overflow narrow viewports -->
      <section class="prose-de prose-measure min-w-0 space-y-8">
        {res.purpose && (
          <section class="mount">
            <h2>Purpose</h2>
            <p>{res.purpose}</p>
          </section>
        )}
        {res.problem && (
          <section class="mount">
            <h2>Problem</h2>
            <p>{res.problem}</p>
          </section>
        )}
        {res.solution && (
          <section class="mount">
            <h2>Solution</h2>
            <p>{res.solution}</p>
          </section>
        )}
        {res.when_to_use && (
          <section class="mount">
            <h2>When to use</h2>
            {Array.isArray(res.when_to_use) ? (
              <ul>
                {res.when_to_use.map((w: any) => (
                  <li>{w}</li>
                ))}
              </ul>
            ) : (
              <p>{res.when_to_use}</p>
            )}
          </section>
        )}
        {res.when_not?.length > 0 && (
          <section class="mount">
            <h2>When not to use</h2>
            <ul>
              {res.when_not.map((w: any) => (
                <li>{w}</li>
              ))}
            </ul>
          </section>
        )}
        {res.editorial && (res.editorial.rating !== undefined || (res.editorial.limitations ?? []).length > 0 || (res.editorial.needs_improvement ?? []).length > 0) && (
          <section class="mount">
            <h2>Our assessment</h2>
            {res.editorial.rating !== undefined && (
              <p>DE//AGENT rating: {res.editorial.rating} / 5</p>
            )}
            {(res.editorial.limitations ?? []).length > 0 && (
              <>
                <h3>Limitations</h3>
                <ul>
                  {res.editorial.limitations.map((l: any) => (
                    <li>{l}</li>
                  ))}
                </ul>
              </>
            )}
            {(res.editorial.needs_improvement ?? []).length > 0 && (
              <>
                <h3>Needs improvement</h3>
                <ul>
                  {res.editorial.needs_improvement.map((n: any) => (
                    <li>{n}</li>
                  ))}
                </ul>
              </>
            )}
          </section>
        )}
        {(res.what_you_need ?? []).length > 0 && (
          <section class="mount">
            <h2>What you need</h2>
            <ul>
              {res.what_you_need.map((w: any) => (
                <li>{w}</li>
              ))}
            </ul>
          </section>
        )}
        {(res.steps ?? []).length > 0 && (
          <section class="mount">
            <h2>Steps</h2>
            <ol>
              {res.steps.map((s: any) => (
                <li>
                  {s.text}
                  {s.from_id && (
                    <span>
                      {' '}(from{' '}
                      <a href={registry.resources.find((r: any) => r.id === s.from_id)?.url ?? `/resources/${s.from_id}`}>
                        {s.from_id}
                      </a>
                      )
                    </span>
                  )}
                </li>
              ))}
            </ol>
          </section>
        )}
        {(res.check_yourself ?? []).length > 0 && (
          <section class="mount">
            <h2>Check yourself</h2>
            <ul>
              {res.check_yourself.map((c: any) => (
                <li>{c}</li>
              ))}
            </ul>
          </section>
        )}
        {(res.source_refs ?? []).length > 0 && (
          <section class="mount">
            <h2>Sourced from</h2>
            <ul>
              {res.source_refs.map((id: any) => (
                <li>
                  <a href={registry.resources.find((r: any) => r.id === id)?.url ?? `/resources/${id}`}>
                    {registry.resources.find((r: any) => r.id === id)?.title ?? id}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
        <section class="mount" data-rate-widget data-resource-id={res.id}>
          <h2>Rating</h2>
          <p data-rate-summary>
            {res.marketplace?.popularity_base !== undefined &&
              `Popularity ${res.marketplace.popularity_base}/100`}
          </p>
          <div data-rate-stars>
            {[1, 2, 3, 4, 5].map((n: any) => (
              <button type="button" data-rate-value={n} aria-label={`Rate ${n} ${n === 1 ? 'star' : 'stars'}`}>★</button>
            ))}
          </div>
          <p data-rate-note>Votes are stored under our editorial rating, not the source.</p>
        </section>
        <script>
          import { plural } from '@/lib/format';

          (() => {
            const widget = document.querySelector('[data-rate-widget]');
            if (!widget) return;
            const id = widget.getAttribute('data-resource-id');
            const summary = widget.querySelector('[data-rate-summary]');
            const render = (avg: any, count: any, pop: any) => {
              if (summary)
                summary.textContent =
                  count > 0
                    ? `★ ${avg} · ${count} ${plural(count, 'vote')} · popularity ${pop}/100`
                    : `No votes yet · popularity ${pop}/100`;
            };
            fetch(`/api/marketplace/stats?resource_id=${encodeURIComponent(id ?? '')}`)
              .then((r) => (r.ok ? r.json() : null))
              .then((j) => {
                if (j?.ok) render(j.data.rating_average, j.data.rating_count, j.data.popularity);
              })
              .catch(() => {});
            widget.querySelectorAll('[data-rate-value]').forEach((btn) => {
              btn.addEventListener('click', () => {
                fetch('/api/marketplace/rate', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ resource_id: id, rating: Number(btn.getAttribute('data-rate-value')) }),
                })
                  .then((r) => (r.ok ? r.json() : null))
                  .then((j) => {
                    if (j?.ok) render(j.rating_average, j.rating_count, j.popularity);
                  })
                  .catch(() => {});
              });
            });
          })();
        </script>
        {(res.vulnerability_scan_at || (res.secret_findings ?? []).length > 0) && (
          <section class="mount">
            <h2>Security scan</h2>
            <p>
              Last sweep{res.vulnerability_scan_at ? ` ${res.vulnerability_scan_at.slice(0, 10)}` : ''}:
              {(res.secret_findings ?? []).filter((f: any) => !f.likelyExample).length} finding(s),
              {(res.secret_findings ?? []).filter((f: any) => f.likelyExample).length} marked as examples.
            </p>
          </section>
        )}
        {res.body && (
          <section class="mount">
            <h2>Details</h2>
            <div class="prose-de prose-measure" set:html={marked.parse(res.body)} />
          </section>
        )}
        {res.context && (
          <section class="mount">
            <h2>Context</h2>
            <p>{res.context}</p>
          </section>
        )}
        {res.forces && res.forces.length && (
          <section class="mount">
            <h2>Forces</h2>
            <ul>{res.forces.map((f: any) => <li>{f}</li>)}</ul>
          </section>
        )}
        {res.symptoms && res.symptoms.length > 0 && (
          <section class="mount">
            <h2>Symptoms</h2>
            <ol style="padding-left: 1.25rem; color: var(--fg-muted);">{res.symptoms.map((s: any) => <li style="margin-block: 0.3rem;">{typeof s === 'string' ? s : Object.values(s)[0]}</li>)}</ol>
          </section>
        )}
        {res.diagnosis && res.diagnosis.length && (
          <section class="mount">
            <h2>Diagnosis</h2>
            <ul>{res.diagnosis.map((d: any) => <li>{typeof d === 'string' ? d : Object.entries(d).map(([k, v]) => `${k}: ${v}`).join(' — ')}</li>)}</ul>
          </section>
        )}
        {res.possible_causes && res.possible_causes.length > 0 && (
          <section class="mount">
            <h2>Possible causes</h2>
            <ul>{res.possible_causes.map((c: any) => <li>{typeof c === 'string' ? c : Object.values(c)[0]}</li>)}</ul>
          </section>
        )}
        {res.commands && res.commands.length && (
          <section class="mount">
            <h2>Commands</h2>
            {res.commands.map((c: any) => (
              <div class="codeblock my-2">
                <pre><code class="language-bash">{c}</code></pre>
                <button class="copy-btn btn btn-sm btn-ghost" onclick="navigator.clipboard.writeText(this.previousElementSibling.innerText)">Copy</button>
              </div>
            ))}
          </section>
        )}
        {res.fix && res.fix.length && (
          <section class="mount">
            <h2>Fix</h2>
            <ul>{res.fix.map((f: any) => <li>{f}</li>)}</ul>
          </section>
        )}
        {res.prevention && res.prevention.length && (
          <section class="mount">
            <h2>Prevention</h2>
            <ul>{res.prevention.map((p: any) => <li>{p}</li>)}</ul>
          </section>
        )}
        {res.monitoring && res.monitoring.length && (
          <section class="mount">
            <h2>Monitoring</h2>
            <ul>{res.monitoring.map((m: any) => <li>{m}</li>)}</ul>
          </section>
        )}
        {res.tradeoffs && res.tradeoffs.length && (
          <section class="mount">
            <h2>Tradeoffs</h2>
            <ul>{res.tradeoffs.map((t: any) => <li>{t}</li>)}</ul>
          </section>
        )}
        {res.implementation && (Array.isArray(res.implementation) ? res.implementation.length : typeof res.implementation === 'string') && (
          <section class="mount">
            <h2>Implementation</h2>
            {Array.isArray(res.implementation) ? (
              <ul>{res.implementation.map((i: any) => <li>{i}</li>)}</ul>
            ) : (
              <p>{res.implementation}</p>
            )}
          </section>
        )}
        {res.tests && res.tests.length && (
          <section class="mount">
            <h2>Tests</h2>
            <ul>{res.tests.map((t: any) => <li>{t}</li>)}</ul>
          </section>
        )}
        {res.failure_scenarios && res.failure_scenarios.length && (
          <section class="mount">
            <h2>Failure Scenarios</h2>
            <ul>{res.failure_scenarios.map((f: any) => <li>{f}</li>)}</ul>
          </section>
        )}
        {res.production_hardening && res.production_hardening.length && (
          <section class="mount">
            <h2>Production Hardening</h2>
            <ul>{res.production_hardening.map((p: any) => <li>{p}</li>)}</ul>
          </section>
        )}
        {res.diagram && (
          <section class="mount">
            <h2>Diagram</h2>
            <pre class="codeblock"><code>{res.diagram}</code></pre>
          </section>
        )}
        {res.repo_structure && (
          <section class="mount">
            <h2>Repository Structure</h2>
            <pre class="codeblock"><code>{res.repo_structure}</code></pre>
          </section>
        )}
        {res.architecture && (
          <section class="mount">
            <h2>Architecture</h2>
            <p>{res.architecture}</p>
          </section>
        )}
        {res.setup && res.setup.length && (
          <section class="mount">
            <h2>Setup</h2>
            <ul>{res.setup.map((s: any) => <li>{s}</li>)}</ul>
          </section>
        )}
        {res.sample_data && (
          <section class="mount">
            <h2>Sample Data</h2>
            <p>{res.sample_data}</p>
          </section>
        )}
        {res.workflow && res.workflow.length && (
          <section class="mount">
            <h2>Workflow</h2>
            <ul>{res.workflow.map((w: any) => <li>{w}</li>)}</ul>
          </section>
        )}
        {res.inputs && res.inputs.length && (
          <section class="mount">
            <h2>Inputs</h2>
            <ul>{res.inputs.map((i: any) => <li>{i}</li>)}</ul>
          </section>
        )}
        {res.outputs && res.outputs.length && (
          <section class="mount">
            <h2>Outputs</h2>
            <ul>{res.outputs.map((o: any) => <li>{o}</li>)}</ul>
          </section>
        )}
        {res.guardrails && res.guardrails.length && (
          <section class="mount">
            <h2>Guardrails</h2>
            <ul>{res.guardrails.map((g: any) => <li>{g}</li>)}</ul>
          </section>
        )}
        {res.example && (
          <section class="mount">
            <h2>Example</h2>
            <p>{res.example}</p>
          </section>
        )}
        {res.evaluation && (
          <section class="mount">
            <h2>Evaluation</h2>
            <p>{res.evaluation}</p>
          </section>
        )}
        {res.capabilities && res.capabilities.length && (
          <section class="mount">
            <h2>Capabilities</h2>
            <ul>{res.capabilities.map((c: any) => <li>{c}</li>)}</ul>
          </section>
        )}
        {res.tools && res.tools.length && (
          <section class="mount">
            <h2>Tools</h2>
            <ul>{res.tools.map((t: any) => <li>{t}</li>)}</ul>
          </section>
        )}
        {res.skills && res.skills.length && (
          <section class="mount">
            <h2>Skills</h2>
            <ul>{res.skills.map((s: any) => <li><a href={s.url ?? '#'} class="link">{s}</a></li>)}</ul>
          </section>
        )}
        {res.hooks && res.hooks.length && (
          <section class="mount">
            <h2>Hooks</h2>
            <ul>{res.hooks.map((h: any) => <li><a href={h.url ?? '#'} class="link">{h}</a></li>)}</ul>
          </section>
        )}
        {res.mcp && res.mcp.length && (
          <section class="mount">
            <h2>MCP Servers</h2>
            <ul>{res.mcp.map((m: any) => <li><a href={m.url ?? '#'} class="link">{m}</a></li>)}</ul>
          </section>
        )}
        {res.commands && res.commands.length && (
          <section class="mount">
            <h2>Commands</h2>
            <ul>{res.commands.map((c: any) => <li><code class="icode">{c}</code></li>)}</ul>
          </section>
        )}
      </section>

      <aside class="sticky top-16 space-y-6">
        <!-- Metadata card -->
        <section class="card card-pad mount">
          <h3 class="mono-label mb-3">Metadata</h3>
          <dl class="space-y-3 text-sm">
            {res.categoryTitle && (
              <div><dt class="text-muted">Category</dt><dd><a href={`/categories/${res.categorySlug}`} class="link">{res.categoryTitle}</a></dd></div>
            )}
            {res.stage && (
              <div><dt class="text-muted">Stage</dt><dd>{stageById[res.stage]?.title ?? res.stage}</dd></div>
            )}
            {res.version && <div><dt class="text-muted">Version</dt><dd class="font-mono">{res.version}</dd></div>}
            {res.license && <div><dt class="text-muted">License</dt><dd class="font-mono">{res.license}</dd></div>}
            {res.author && <div><dt class="text-muted">Author</dt><dd>{res.author}</dd></div>}
            {res.publisher && <div><dt class="text-muted">Publisher</dt><dd>{res.publisher}</dd></div>}
            {res.last_verified && <div><dt class="text-muted">Last Verified</dt><dd class="font-mono">{res.last_verified}</dd></div>}
            {res.source_url && <div><dt class="text-muted">Source</dt><dd><a href={res.source_url} target="_blank" rel="noopener" class="link">{res.source_url}</a></dd></div>}
            {res.github_url && <div><dt class="text-muted">Repository</dt><dd><a href={res.github_url} target="_blank" rel="noopener" class="link">{res.github_url}</a></dd></div>}
            {res.files && res.files.length && <div><dt class="text-muted">Files</dt><dd>{res.files.join(', ')}</dd></div>}
          </dl>
        </section>

        <!-- Security card -->
        <section class="card card-pad mount">
          <h3 class="mono-label mb-3">Security Posture</h3>
          <p class="text-sm text-muted mb-3">A listing is not an endorsement. Review the flags before connecting.</p>
          <dl class="space-y-2 text-sm">
            {Object.entries(res.security ?? {}).map(([k, v]) => (
              <div class="flex items-center justify-between">
                <dt class="text-muted capitalize">{k.replace(/_/g, ' ')}</dt>
                <dd class="font-mono">{v === true ? 'Yes' : v === false ? 'No' : '—'}</dd>
              </div>
            ))}
          </dl>
        </section>

        <!-- Static trust scan card (pipelines/scan-trust.mjs) -->
        {trustScan && (
          <section class="card card-pad mount">
            <h3 class="mono-label mb-3">Static trust scan</h3>
            <p class="text-sm text-muted mb-3">
              {trustScan.rulesApplied} rules across 11 families ran over {trustScan.files_scanned} files.
              Findings are evidence for review — not an automatic verdict. <a href="/docs/trust-rules" class="link">Rule catalog</a>
            </p>
            {trustScan.findings.length === 0 ? (
              <p class="text-sm" style="color: var(--color-ok);">No static findings.</p>
            ) : (
              <ul style="list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem;">
                {trustScan.findings.map((f: any) => (
                  <li style="border-left: 2px solid var(--color-{f.risk === 'critical' ? 'danger' : f.risk === 'high' ? 'warn' : 'info'}); padding-left: 0.6rem;">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class={`chip chip-${f.risk === 'critical' ? 'danger' : f.risk === 'high' ? 'warn' : 'info'}`}>{f.risk}</span>
                      <span class="text-sm" style="color: var(--fg);">{f.title}</span>
                      {f.likelyExample && <span class="chip" style="color: var(--fg-dim);">docs context</span>}
                      {f.judged && (
                        <span class="chip" style={f.judged.verdict === 'benign-in-context' ? 'color: var(--color-ok);' : 'color: var(--color-warn);'} title={f.judged.explanation}>
                          judged: {f.judged.verdict}
                        </span>
                      )}
                    </div>
                    <p class="text-xs text-muted" style="margin: 0.25rem 0 0;">{f.judged ? f.judged.explanation : f.definition}</p>
                    <p class="font-mono text-2xs text-dim" style="margin: 0.15rem 0 0; overflow-wrap: anywhere;">{f.file}:{f.line}</p>
                    <p class="text-xs" style="margin: 0.2rem 0 0; color: var(--fg-muted);">Fix: {f.remediation}</p>
                  </li>
                ))}
              </ul>
            )}
            {trustScan.examples > 0 && (
              <p class="text-xs text-dim" style="margin-top: 0.6rem;">{trustScan.examples} finding{trustScan.examples === 1 ? '' : 's'} matched only documentation context and do not count against this entry.</p>
            )}
          </section>
        )}

        <!-- Provenance card -->
        <section class="card card-pad mount">
          <h3 class="mono-label mb-3">Provenance</h3>
          <dl class="space-y-2 text-sm">
            <div><dt class="text-muted">Verification</dt><dd class="font-mono capitalize">{res.verification}</dd></div>
            {res.evidence_summary && <div><dt class="text-muted">Evidence</dt><dd class="font-mono text-xs">{Object.values(res.evidence_summary.checks).filter((c: any) => c.status === 'passed').length}/10 checks · earned {res.evidence_summary.earned}</dd></div>}
            {res.stale && <div class="text-warn"><dt class="text-muted">Stale</dt><dd>Last verified {res.stale_days} days ago (>180 days)</dd></div>}
            {res.source_file && <div><dt class="text-muted">Source File</dt><dd class="font-mono text-xs">{String(res.source_file).replace(/\\/g, '/')}</dd></div>}
            {res.publisher_source && typeof res.publisher_source === 'object' && (
              <div>
                <dt class="text-muted">Upstream</dt>
                <dd class="font-mono text-xs">
                  {res.publisher_source.unreachable
                    ? `Repo unreachable (checked ${(res.publisher_source.checked_at ?? '').slice(0, 10)})`
                    : `${res.publisher_source.repo ?? 'repo'} · pushed ${(res.publisher_source.pushed_at ?? '').slice(0, 10) || 'unknown'}`}
                </dd>
              </div>
            )}
          </dl>
        </section>

        <!-- Before you trust this -->
        <section class="card card-pad mount">
          <h3 class="mono-label mb-3">Before you trust this</h3>
          <dl class="space-y-2 text-sm">
            <div>
              <dt class="text-muted">Limitations</dt>
              <dd class="text-sm">
                {limitations.length > 0 ? (
                  <ul class="space-y-1">
                    {limitations.map((l: any) => (
                      <li>{typeof l === 'string' ? l : JSON.stringify(l)}</li>
                    ))}
                  </ul>
                ) : (
                  <span class="text-muted">No documented limitations — treat the unknown as unknown, not as safe.</span>
                )}
              </dd>
            </div>
            <div>
              <dt class="text-muted">Prerequisites</dt>
              <dd class="text-sm">{prereqs.length ? prereqs.map((p: any) => p.title).join(' · ') : 'None declared'}</dd>
            </div>
            {res.evidence_summary && (
              <div>
                <dt class="text-muted">Evidence checklist</dt>
                <dd class="flex flex-wrap gap-1.5 mt-1">
                  {Object.entries(res.evidence_summary.checks).map(([check, c]: any) => (
                    <span class="chip text-xs" title={c.status === 'unclaimed' ? 'no evidence on file' : `${c.status} · ${c.by ?? 'unknown'} · ${c.at ?? 'undated'}`}>{check.replace(/_/g, ' ')}: {c.status}</span>
                  ))}
                </dd>
              </div>
            )}
          </dl>
        </section>

        <!-- Prerequisites -->
        {prereqs.length && (
          <section class="card card-pad mount">
            <h3 class="mono-label mb-3">Prerequisites</h3>
            <ul class="space-y-1">
              {prereqs.map((p: any) => (
                <li><a href={p.url} class="link text-sm">{p.title}</a> <span class="text-dim">({p.typeLabel})</span></li>
              ))}
            </ul>
          </section>
        )}

        <!-- Related -->
        {relationships.some(([_, v]) => v?.length) && (
          <section class="card card-pad mount">
            <h3 class="mono-label mb-3">Relationships</h3>
            <dl class="space-y-2 text-sm">
              {relationships.map(([rel, list]) => list?.length && (
                <div>
                  <dt class="text-muted capitalize">{rel.replace(/_/g, ' ')}</dt>
                  <dd class="flex flex-wrap gap-1.5 mt-1">
                    {list.map((id: any) => {
                      const r = registry.resources.find((x: any) => x.id === id);
                      return r ? <a href={r.url} class="chip text-xs">{r.title}</a> : <span class="chip text-xs">{id}</span>;
                    })}
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        <!-- Related in the graph (computed, not curated) -->
        {(res.related_computed ?? []).length > 0 && (
          <section class="card card-pad mount">
            <h3 class="mono-label mb-3">Related in the graph</h3>
            <ul class="space-y-1">
              {(res.related_computed ?? []).map((rel: any) => {
                const r = registry.resources.find((x: any) => x.id === rel.id);
                return r ? <li><a href={r.url} class="link text-sm">{r.title}</a> <span class="text-dim">({r.typeLabel})</span></li> : null;
              })}
            </ul>
            <p class="card-desc" style="margin-top: 0.75rem;">Computed from shared taxonomy — not curator endorsements.</p>
          </section>
        )}

        <!-- Technologies -->
        {techs.length && (
          <section class="card card-pad mount">
            <h3 class="mono-label mb-3">Technologies</h3>
            <ul class="space-y-1">
              {techs.map((t: any) => (
                <li><a href={`/taxonomy#${t.slug}`} class="link text-sm">{t.name}</a> <span class="text-dim">({t.category})</span></li>
              ))}
            </ul>
          </section>
        )}

        <!-- Marketplace Quality Scores -->
        {compositeScore > 0 && (
          <section class="card card-pad mount">
            <h3 class="mono-label mb-3">Marketplace Quality Score</h3>
            <div class="mb-4">
              <div class="flex items-center gap-3 mb-2">
                <span class="chip" style={`color: var(--color-${scoreColor(compositeScore)})`}>{compositeLabel} ({compositeScore}/100)</span>
                {ratingCount > 0 && (
                  <span class="chip" style="color: var(--color-accent);">
                    {ratingAvg.toFixed(1)}/5 ({ratingCount} reviews)
                  </span>
                )}
                {installCount > 0 && (
                  <span class="chip">
                    {installCount} installs ({(installSuccessRate * 100).toFixed(0)}% success)
                  </span>
                )}
              </div>
              <p class="text-sm text-muted">
                Rule-based scoring across 7 dimensions. Higher is better. <a href="/docs/scoring" class="link">How it works</a>
              </p>
            </div>
            <div class="space-y-3">
              {Object.entries(qualityScores).map(([dim, score]) => (
                <div>
                  <div class="flex justify-between text-sm mb-1">
                    <span class="capitalize">{dim.replace(/_/g, ' ')}</span>
                    <span class="font-mono" style={`color: var(--color-${scoreColor(Number(score))})`}>{score}/100</span>
                  </div>
                  <div class="h-2 bg-muted rounded-full overflow-hidden">
                    <div class="h-full rounded-full" style={`width: ${score}%; background-color: var(--color-${scoreColor(Number(score))})`}></div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Roadmap Alignment -->
        {mp?.roadmap_stages?.length > 0 && (
          <section class="card card-pad mount">
            <h3 class="mono-label mb-3">Roadmap Alignment</h3>
            <div class="flex flex-wrap gap-2">
              {mp.roadmap_stages.map((stageId: string) => {
                const stage = registry.taxonomy.stagesById?.[stageId];
                return stage ? (
                  <span class="chip">{stage.title} ({mp.roadmap_phase})</span>
                ) : (
                  <span class="chip">{stageId}</span>
                );
              })}
            </div>
            <p class="text-sm text-muted mt-2">This artifact teaches skills for the stages above in the 13-stage Data Engineering roadmap.</p>
          </section>
        )}

        {mp?.install_manifest && (
          <section class="card card-pad mount">
            <h3 class="mono-label mb-3">Installation Manifest</h3>
            <dl class="space-y-2 text-sm">
              <div><dt class="text-muted">Version</dt><dd class="font-mono">{mp.install_manifest.version}</dd></div>
              <div><dt class="text-muted">Requirements</dt><dd>{mp.install_manifest.requirements?.join(', ') ?? 'None'}</dd></div>
              <div><dt class="text-muted">Commands</dt><dd class="font-mono text-xs">{mp.install_manifest.commands?.map((c: any) => c.argv.join(' ')).join(' ; ') ?? 'None'}</dd></div>
            </dl>
            <p class="text-sm text-muted mt-2">Run <code>node pipelines/execute.mjs --manifest &lt;file&gt; --backend local --local-i-understand</code> to execute the install manifest.</p>
          </section>
        )}

        <!-- Install manifest action (rating lives in the Rating widget above) -->
        {mp?.install_manifest && (
          <section class="card card-pad mount">
            <h3 class="mono-label mb-3">Install</h3>
            <div>
              <p class="text-sm text-muted mb-2">Run the installation manifest to install this artifact:</p>
              <button id="install-btn" class="btn btn-accent" onclick="installResource('{res.id}')">
                Install {res.title}
              </button>
              <div id="install-result" class="mt-3 hidden"></div>
            </div>
          </section>
        )}
      </aside>
    </div>
    <Feedback resourceId={res.id} resourceTitle={res.title} />
  </main>
</BaseLayout>

<script is:inline>
  async function installResource(resourceId) {
    const btn = document.getElementById('install-btn');
    const resultDiv = document.getElementById('install-result');
    if (!btn || !resultDiv) return;

    btn.disabled = true;
    btn.textContent = 'Fetching manifest...';
    resultDiv.hidden = true;

    try {
      const resp = await fetch('/api/marketplace/install', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ resource_id: resourceId, backend: 'dry' }),
      });
      if (!resp.ok) {
        throw new Error('Install service unavailable (static preview) — copy the manifest from the docs instead.');
      }
      const data = await resp.json();

      if (!data.ok) {
        throw new Error(data.error ?? 'Failed to fetch install manifest');
      }

      btn.textContent = 'Manifest ready — run locally';
      resultDiv.hidden = false;
      resultDiv.innerHTML = `
        <div class="codeblock" style="max-height: 300px; overflow: auto;">
          <pre><code>${JSON.stringify(data.manifest, null, 2)}</code></pre>
        </div>
        <p class="text-sm text-muted mt-2">
          Save the manifest above as a YAML file and run:
          <code>node pipelines/execute.mjs --manifest <file> --backend local --local-i-understand</code>
        </p>
      `;
    } catch (err) {
      resultDiv.hidden = false;
      resultDiv.innerHTML = `<span class="text-danger">Error: ${err.message}</span>`;
      btn.disabled = false;
      btn.textContent = 'Retry';
    }
  }
</script>