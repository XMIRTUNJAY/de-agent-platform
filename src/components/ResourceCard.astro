---
// ResourceCard — registry resource summary card (amp hairline-card grammar).
// Hierarchy per AUD-013: identity row → title → description (2-line clamp,
// deduped against the title) → install action → meta row (≤ 6 elements).
// Description falls back through tagline → summary → first description
// sentence → first learning objectives (AUD-001): cards never ship without
// useful, registry-derived text.
import { formatScore, scoreBand } from '@/lib/format';

interface Props {
  resource: any;
}
const { resource: r } = Astro.props;
const verified = r.last_verified;
const dateFmt = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' });
const verifiedLabel = verified && dateFmt.format(new Date(verified));
const isEarnedVerification = ['reviewed', 'tested', 'verified'].includes(r.verification);

// Marketplace data
const mp = r.marketplace;
const compositeScore: number | null = mp?.composite_score ?? null;
const band = scoreBand(compositeScore);
const compositeLabel = mp?.composite_label || band.label;
const installCount = mp?.install_count ?? 0;

// Score gauge geometry (r=15.5 → circumference ≈ 97.39)
const C = 97.39;
const arc = Math.max(0, Math.min(100, band.pct)) * (C / 100);

// Copy-install label: first tokens of the REAL command (never invented)
const cmdFirstLine = (r.install_command ?? '').split('\n')[0];
const cmdPrefix = cmdFirstLine.split(' ').slice(0, 3).join(' ');
const cmdIsComment = cmdFirstLine.startsWith('#');

/** first complete sentence ending in . or ? or ! (min 12 chars) */
function firstSentence(text: string): string {
  const m = text.match(/(.{12,}?[.?!])(\s|$)/s);
  return m ? m[1] : text;
}

/** description text, deduped against the title (cards often repeat it) */
function describeText(): string {
  const title = String(r.title ?? '').trim();
  const cands: (string | undefined)[] = [r.tagline, r.summary, r.purpose, r.description ? firstSentence(String(r.description)) : ''];
  let text = '';
  for (const c of cands) {
    if (!c) continue;
    text = String(c).trim();
    const ti = text.toLowerCase().indexOf(title.toLowerCase());
    if (ti > -1 && title.length > 2) {
      const stripped = text.slice(ti + title.length).replace(/^[\s:—–-]*(?:is|are|—|-|:)?\s*/i, '').trim();
      if (stripped.length >= 40) {
        text = stripped;
        break;
      }
    }
    break;
  }
  return text;
}
const descText = describeText();
const lacksDepth = descText.length < 80;
const objectives = (r.learning_objectives ?? []).slice(0, 2);
/** structured fallback: show objectives instead of a thin fragment */
const showObjectives = lacksDepth && objectives.length > 0;
---

<a href={r.url} class="card card-pad card-interactive resource-card">
  <div class="card-header card-head identity-row">
    <span class="type-badge" data-type={r.type}>
      <span class="type-badge-dot" aria-hidden="true"></span>
      {r.typeLabel}
    </span>
    {mp && (
      <span
        class="score-pill"
        data-tone={band.tone}
        title={`Composite score ${formatScore(compositeScore)} · ${compositeLabel}`}
      >
        <svg viewBox="0 0 36 36" width="26" height="26" aria-hidden="true">
          <circle class="gauge-track" cx="18" cy="18" r="15.5" stroke-width="3.5" fill="none" />
          <circle
            class="gauge-arc"
            cx="18"
            cy="18"
            r="15.5"
            stroke-width="3.5"
            fill="none"
            stroke-linecap="round"
            stroke-dasharray={`${arc.toFixed(2)} ${C.toFixed(2)}`}
          />
        </svg>
        <span class="gauge-value">{formatScore(compositeScore)}</span>
        <span class="score-pill-label">{compositeLabel}</span>
      </span>
    )}
  </div>
  <h3 class="card-title" style="font-size: var(--text-xl); font-weight: 500; line-height: 1.3; color: var(--fg);">{r.title}</h3>
  {showObjectives ? (
    <ul class="card-objectives" style="flex: 1; margin: 0.4rem 0 0; padding-left: 1.1rem; color: var(--fg-muted); font-size: var(--text-sm);">
      {objectives.map((o: string) => <li style="margin-block: 0.2rem;">{o}</li>)}
    </ul>
  ) : (
    (descText && (
      <p class="card-desc" style="flex: 1;">{descText}</p>
    ))
  )}
  {r.install_command && !cmdIsComment && (
    <button
      type="button"
      class="copy-install"
      data-cmd={r.install_command}
      title={`Copy: ${cmdFirstLine}`}
      aria-label={`Copy install command for ${r.title}`}
      onclick="event.preventDefault(); event.stopPropagation(); navigator.clipboard.writeText(this.dataset.cmd); this.classList.add('copied'); setTimeout(() => this.classList.remove('copied'), 1400);"
    >
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <rect x="9" y="9" width="12" height="12" rx="2" />
        <path d="M5 15V5a2 2 0 0 1 2-2h10" stroke-linecap="round" />
      </svg>
      <span class="copy-install-label">{cmdPrefix}</span>
    </button>
  )}
  <details class="card-details">
    <summary>Details</summary>
    <div class="card-meta" style="margin-top: 0.5rem; display: flex; flex-wrap: wrap; gap: 0.35rem; align-items: center;">
      {r.difficulty && <span class="chip">{r.difficulty}</span>}
      {(r.tags || []).slice(0, 2).map((t: string) => <span class="chip">{t}</span>)}
      {installCount > 0 && (
        <span class="chip" style="font-size: var(--text-2xs);">{installCount} installs</span>
      )}
      {r.evidence_summary && r.evidence_summary.gap > 0 ? (
        <span class="chip chip-warn" style="margin-left: auto; font-size: var(--text-2xs);">claimed {r.verification}</span>
      ) : (
        isEarnedVerification && verifiedLabel && <span class="chip chip-accent" style="margin-left: auto; font-size: var(--text-2xs);">✓ {r.verification} {verifiedLabel}</span>
      )}
      {!isEarnedVerification && r.verification === 'community' && (
        <span class="chip" style="margin-left: auto; font-size: var(--text-2xs);">community</span>
      )}
    </div>
  </details>
</a>

<style>
  .resource-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    content-visibility: auto;
    contain-intrinsic-size: auto 220px;
  }
  .identity-row {
    margin-bottom: 0.6rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem;
  }
  .card-title {
    margin: 0;
  }
  .card-desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin: 0.4rem 0 0;
    padding-left: 0;
  }
  .copy-install {
    margin-top: 0.9rem;
    align-self: flex-start;
  }
  .score-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.55rem 0.15rem 0.25rem;
    border-radius: 999px;
    border: 1px solid var(--hairline);
    background: var(--bg-elevated);
  }
  .score-pill .gauge-value {
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .score-pill-label {
    font-size: var(--text-2xs);
    color: var(--fg-muted);
    text-transform: capitalize;
  }
  .card-details {
    margin-top: 0.7rem;
    border-top: 1px solid var(--hairline);
  }
  .card-details summary {
    cursor: pointer;
    padding: 0.45rem 0 0.15rem;
    font-size: var(--text-2xs);
    color: var(--fg-muted);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    user-select: none;
  }
  .card-details summary::-webkit-details-marker {
    display: none;
  }
  .card-details summary::after {
    content: '▾';
    font-size: 0.7em;
    transition: transform 0.15s ease;
  }
  .card-details[open] summary::after {
    transform: rotate(180deg);
  }
</style>
