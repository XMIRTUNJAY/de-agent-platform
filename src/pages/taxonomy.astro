---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import registry from '@/data/generated/registry.json';
import { count as countLabel } from '@/lib/format';

const stages = registry.taxonomy.stages;
const categories = registry.taxonomy.categories.sort((a,b) => a.order - b.order);
const technologies = registry.taxonomy.technologies;
const catByStage: Record<string, typeof categories> = {};
for (const c of categories) (catByStage[c.stage] ??= []).push(c);
---

<BaseLayout title="Taxonomy · DE//AGENT" sidebar>
  <PageHero
    kicker="Canonical taxonomy"
    title="Data engineering taxonomy"
    lede={`${countLabel(categories.length, 'category')} grouped into ${countLabel(stages.length, 'roadmap stage', 'roadmap stages')}. Every resource maps to exactly one category; categories map to stages. This is the spine for the roadmap, the registry and search.`}
  />

  <section class="col section">
    <div style="display: grid; gap: 4rem;">
      {stages.map((stage) => {
        const cats = catByStage[stage.id] ?? [];
        if (!cats.length) return null;
        return (
          <section class="reveal">
            <SectionHeader
              kicker={`Stage ${String(stage.order).padStart(2, '0')}`}
              title={stage.title}
              lede={stage.summary}
            />
            <div class="card-grid stagger" style="margin-top: 1.75rem;">
              {cats.map((cat: any) => {
                const count = registry.resources.filter(r => r.category === cat.id).length;
                const types = [...new Set(registry.resources.filter(r => r.category === cat.id).map(r => r.type))];
                return (
                  <a href={`/categories/${cat.slug}`} class="card card-pad card-interactive">
                    <p class="mono-label">{cat.group}</p>
                    <h3 style="margin-top: 0.4rem; font-weight: 500;">{cat.title}</h3>
                    <p class="card-desc">{cat.summary}</p>
                    <div class="card-meta">
                      <span class="chip">{countLabel(count, 'resource')}</span>
                      {types.slice(0,3).map(t => <span class="chip">{registry.resources.find(r => r.type === t)?.typeLabel ?? t}</span>)}
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>
  </section>

  <hr class="hairline col" />

  <section class="col section">
    <SectionHeader
      kicker="Technologies"
      title="First-class references"
      lede="Technology references used by resources across the registry."
    />
    <div class="card-grid stagger" style="margin-top: 2rem; gap: 0.75rem;">
      {technologies.map((t) => (
        <a id={t.slug} href={t.homepage ?? '#'} target={t.homepage ? '_blank' : undefined} rel="noopener" class="card card-pad-sm card-interactive">
          <h3 style="font-weight: 500;">{t.name}</h3>
          <p style="font-size: var(--text-sm); color: var(--fg-muted); margin-top: 0.2rem;">{t.category}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
