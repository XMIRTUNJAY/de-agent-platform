---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import registry from '@/data/generated/registry.json';
import stats from '@/data/generated/stats.json';
import { count as countLabel } from '@/lib/format';
import { PHASES } from '@/lib/phases';

const stages = registry.taxonomy.stages;
const categories = registry.taxonomy.categories;
const resources = registry.resources;
const roadmapData = (registry as any).roadmap?.roadmap ?? {};
const roadmapStages = (roadmapData.stages ?? {}) as Record<string, { gate?: string; artifact?: string; teaches?: string; can_do?: string[] }>;
const tracks = (roadmapData.tracks ?? []) as { title: string; description: string; path: string[] }[];

const catByStage: Record<string, typeof categories> = {};

/** byStage counts keyed by stage id */
const stageCounts = stats.byStage as Record<string, number>;
const stageReading = (stats.byStageReading ?? {}) as Record<string, number>;
const gaps = ((stats as any).roadmapGaps ?? []) as { stage: string; needsOriginal: string | null }[];
const gapByStage: Record<string, { stage: string; needsOriginal: string | null }> = {};
for (const g of gaps) gapByStage[g.stage] = g;
for (const c of categories) (catByStage[c.stage] ??= []).push(c);

const stageById = new Map(stages.map((s: any) => [s.id, s]));
// Journey: phases -> stages (canonical module), with rendered extras attached
const journey = PHASES.map((phase) => {
  const sts = phase.stageIds
    .map((id) => stageById.get(id))
    .filter((s): s is any => Boolean(s))
    .sort((a: any, b: any) => a.order - b.order)
    .map((stage: any) => ({
      stage,
      count: stageCounts[stage.id] ?? 0,
      reading: stageReading[stage.id] ?? 0,
      gate: roadmapStages[stage.id],
      gap: gapByStage[stage.id],
    }));
  return { phase, sts, count: sts.reduce((n, s) => n + s.count, 0) };
});
---

<BaseLayout title="Roadmap · DE//AGENT" sidebar>

  <PageHero
    kicker="Learning roadmap"
    title="The Data Engineering Roadmap"
    lede={`${countLabel(registry.taxonomy.stages.length, 'stage')} from Foundations to Agentic Data Engineering. Each has an exit gate you can prove and a deliverable artifact.`}
  />

  <!-- Phase stepper — connected journey rail (audit S2.2) -->
  <section class="col section" aria-label="Roadmap phases" style="padding-top: 2rem;">
    <ol class="phase-stepper" style="list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.75rem;">
      {journey.map(({ phase, count }, i) => (
        <li style="position: relative;">
          <a href={`#phase-${phase.index}`} class="stepper-step card card-pad-sm card-interactive" style="display: flex; align-items: flex-start; gap: 0.65rem; height: 100%;">
            <span class="stepper-num" aria-hidden="true">{phase.index}</span>
            <span style="display: flex; flex-direction: column; gap: 0.15rem; min-width: 0;">
              <span style="font-weight: 500; color: var(--fg);">{phase.name}</span>
              <span class="text-dim font-mono text-2xs">{countLabel(count, 'resource')} · {phase.stageIds.length} stages</span>
            </span>
          </a>
          {i < journey.length - 1 && <span class="stepper-connector" aria-hidden="true"></span>}
        </li>
      ))}
    </ol>
  </section>

  <hr class="hairline col" />

  <!-- Main path — phases → stages, stable anchors, exit gates -->
  <section class="col section">
    {journey.map(({ phase, sts }) => (
      <div id={`phase-${phase.index}`} style="margin-bottom: 2rem;">
        <div class="flex items-baseline gap-3" style="margin: 1rem 0 0.25rem;">
          <h2 class="display" style="font-size: var(--text-2xl); margin: 0;">Phase {phase.index} — {phase.name}</h2>
        </div>
        <p class="text-muted" style="max-width: 62ch; margin-bottom: 0.5rem;">{phase.tagline}</p>
        <ol style="list-style: none; padding: 0; margin: 0;">
          {sts.map(({ stage, count, reading, gate, gap }) => {
            const cats = (catByStage[stage.id] ?? []).sort((a: any, b: any) => a.order - b.order);
            return (
              <li id={stage.slug ?? stage.id} class:list={['reveal']} style="padding-top: 1rem;">
                <a href={`#${stage.slug ?? stage.id}`} class="chapter-row chapter-stage">
                  <span class="chapter-num">{String(stage.order).padStart(2, '0')}</span>
                  <span style="flex: 1; min-width: 0;">
                    <span style="display: block; font-size: var(--text-2xl); font-weight: 500;">{stage.title}</span>
                    <span style="display: block; color: var(--fg-muted); margin-top: 0.35rem;">{stage.summary}</span>
                  </span>
                  <span class="chip">{countLabel(count, 'guide & tool', 'guides & tools')}{reading > 0 ? ` · ${reading} further reading` : ''}</span>
                  {gap && (
                    <span class="chip" title="Queued in the heartbeat loop — not yet published, never indexed until it clears auto-gates">
                      upcoming: {gap.needsOriginal ? `${gap.needsOriginal} + tutorial` : 'tutorial'}
                    </span>
                  )}
                </a>
                {gate && (
                  <div class="gate-callout" style="margin: 0 0.5rem 1.25rem 4.25rem;">
                    <span class="gate-tag">Gate</span>
                    <span style="color: var(--fg);">{gate.gate ?? '—'}</span>
                    {gate.artifact && <>
                      <span style="margin: 0 0.5rem; color: var(--fg-dim);">·</span>
                      {(() => {
                        const target = resources.find((r: any) => r.id === gate.artifact);
                        return target?.url ? (
                          <a href={target.url}>Deliverable: {target.title}</a>
                        ) : (
                          <code class="icode">{gate.artifact}</code>
                        );
                      })()}
                    </>}
                  </div>
                )}
                {stage.outcomes?.length > 0 && (
                  <div class="stage-indent" style="padding: 0 0.5rem 0 4.25rem;">
                    <p class="mono-label" style="margin: 0 0 0.35rem;">You can, after this stage</p>
                    <ul style="list-style: none; padding: 0; margin: 0 0 1rem; display: flex; flex-wrap: wrap; gap: 0.4rem;">
                      {stage.outcomes.map((o: string) => <li class="chip" style="font-size: var(--text-2xs);">{o}</li>)}
                    </ul>
                  </div>
                )}
                <div class="stage-indent" style="padding: 0 0.5rem 2rem 4.25rem; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));">
                  {cats.map((cat: any) => {
                    const catCount = resources.filter(r => r.category === cat.id).length;
                    // Empty categories stay in the taxonomy but don't get a card:
                    // a card to an empty page is a dead end, not navigation.
                    if (catCount === 0) return null;
                    return (
                      <a href={`/categories/${cat.slug}`} class="card card-pad card-interactive">
                        <p class="mono-label">{cat.group}</p>
                        <h4 style="margin-top: 0.4rem; font-weight: 500;">{cat.title}</h4>
                        <p style="margin-top: 0.4rem; font-size: var(--text-sm); color: var(--fg-muted);">{cat.summary}</p>
                        <p style="margin-top: 0.6rem; font-size: var(--text-xs); color: var(--fg-dim); font-family: var(--font-mono);">{countLabel(catCount, 'resource')}</p>
                      </a>
                    );
                  })}
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    ))}
  </section>

  <hr class="hairline col" />

  <!-- Provider tracks -->
  <section class="col section">
    <SectionHeader
      kicker="Provider tracks"
      title="Platform-specific paths"
      lede="A focused sequence per provider — combine any track with the main roadmap."
    />
    <div class="card-grid stagger" style="margin-top: 3rem;">
      {tracks.map((t: any) => (
        <article class="card card-pad-lg">
          <h3 style="font-size: var(--text-lg); font-weight: 500;">{t.title}</h3>
          <p class="card-desc">{t.description}</p>
          <div class="card-meta">
            {t.path.map((p: any) => <span class="chip">{p}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>

</BaseLayout>

<style>
  .chapter-stage { border-top: 1px solid var(--border); padding-top: 2rem; }
  .mono-teach { border-left: 2px solid var(--border); margin-left: 1rem; }

  /* Phase stepper (audit S2.2) — numbered steps with connector line */
  .stepper-step { position: relative; z-index: 1; }
  .stepper-num {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
    border-radius: 999px;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    background: var(--accent-soft);
  }
  .stepper-connector {
    display: none;
    position: absolute;
    top: 1.6rem;
    left: calc(50% + 1.6rem);
    right: calc(-50% + 1.6rem);
    height: 1px;
    background: var(--border-strong);
  }
  /* connectors only where the grid is guaranteed single-row */
  @media (min-width: 1200px) {
    .stepper-connector { display: block; }
  }
  /* Exit-gate callout (audit S2.2) */
  .gate-callout {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--accent-soft);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }
  .gate-tag {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
  }
  /* narrow screens: the 4.25rem stage indent + 240px card min overflow 320px;
     drop the indent, go single column. !important beats the inline styles. */
  @media (max-width: 480px) {
    .stage-indent { padding-left: 0.5rem !important; padding-right: 0.5rem !important; }
    .stage-indent[style*='grid-template-columns'] { grid-template-columns: 1fr !important; }
    .gate-callout { margin-left: 0.5rem !important; margin-right: 0.5rem !important; }
    .mono-teach { margin-left: 0.5rem; }
    .chapter-row { padding-left: 0.75rem; padding-right: 0.75rem; }
    .chapter-num { display: none; }
  }
</style>
