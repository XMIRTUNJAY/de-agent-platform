---
// /sources/[id] — provenance page for each discovery source (81 pages).
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadSources, draftCounts, buildSourcePage } from '../../../pipelines/lib/sources-pages.mjs';

export async function getStaticPaths() {
  return loadSources().map((s: any) => ({ params: { id: s.id } }));
}
const { id } = Astro.params;
const source = loadSources().find((s: any) => s.id === id);
if (!source) return Astro.redirect('/marketplace');
const page = buildSourcePage(source, draftCounts()) as any;
---

<BaseLayout title={`${page.title} — source provenance`} description={`${page.lede}. What it publishes, how it enters the registry, and how to verify against the origin.`}>
  <section class="col section-sm" style="padding-top: 2.5rem; max-width: 76ch;">
    <p class="kicker">Source provenance</p>
    <h1 style="font-size: var(--text-2xl); font-weight: 500; margin-top: 0.5rem;">{page.title}</h1>
    <p class="text-dim font-mono text-sm" style="margin-top: 0.4rem;">{page.lede}</p>
    {page.sections.map((s: any) => (
      <section id={s.id} style="margin-top: 2.25rem;">
        <h2 style="font-size: var(--text-xl); font-weight: 500;">{s.title}</h2>
        <div class="prose-de" style="margin-top: 0.6rem;" set:html={s.html} />
      </section>
    ))}
    <p style="margin-top: 2rem;"><a href="/docs/how-it-works" class="link">← How the platform works</a></p>
  </section>
</BaseLayout>
