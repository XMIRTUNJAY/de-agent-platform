---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ResourceCard from '@/components/ResourceCard.astro';
import PipelineDiagram from '@/components/diagrams/PipelineDiagram.astro';
import { SITE } from '@/site.config';
import registry from '@/data/generated/registry.json';
import stats from '@/data/generated/stats.json';
import { count as countLabel } from '@/lib/format';
import { PHASES, type Phase } from '@/lib/phases';

const stages = registry.taxonomy.stages;

/** byStage counts keyed by stage id */
const stageCounts = stats.byStage as Record<string, number>;

interface Stage { id: string; order: number; title: string; slug: string; }
const stageById = new Map((stages as unknown as Stage[]).map((s) => [s.id, s] as const));
const phases = PHASES.map((phase: Phase) => {
  const sts = phase.stageIds.map((id) => stageById.get(id)).filter((s): s is Stage => !!s)
    .sort((a, b) => a.order - b.order);
  return { index: phase.index, name: phase.name, tagline: phase.tagline, stages: sts, count: sts.reduce((n, s) => n + (stageCounts[s.id] ?? 0), 0) };
});

// Hero install example — a real skill with a real install command
const skill = registry.resources.find(r => r.type === 'skill' && r.install_command)!;
const byVerification = stats.counts.byVerification as Record<string, number>;

// Learn by building — starters + architectures
const builders = registry.resources
  .filter(r => r.type === 'starter' || r.type === 'architecture')
  .slice(0, 6);

// Fresh from the registry — newest by last_verified

const fresh = registry.resources
  .filter(r => r.last_verified)
  .sort((a, b) => (b.last_verified ?? '').localeCompare(a.last_verified ?? ''))
  .slice(0, 6);

// Top-rated entries — derived from real composite scores (no editorial picks)
const topRated = registry.resources
  .filter(r => (r.marketplace?.composite_score ?? 0) > 0 && (r.page_eligibility?.state ?? 'eligible') !== 'internal_only')
  .sort((a, b) => (b.marketplace?.composite_score ?? 0) - (a.marketplace?.composite_score ?? 0))
  .slice(0, 3);

// Learn / Build / Install / Operate — the platform's four verbs
const verbs = [
  { label: 'Learn', href: '/roadmap', note: 'A 13-stage roadmap with exit gates you can prove — foundations to agentic data engineering.' },
  { label: 'Build', href: '/projects', note: 'Starter projects and reference architectures you can run locally end-to-end.' },
  { label: 'Install', href: '/marketplace', note: 'Agent skills and MCP servers, each with install commands and a machine-readable security posture.' },
  { label: 'Operate', href: '/runbooks', note: 'Production runbooks for incidents: symptom, diagnosis, recovery, validation.' },
];

const heroLines = ['Learn the pattern.', 'Install the skill.', 'Run the pipeline.', 'Ship agent-native data.'];
---

<BaseLayout title={SITE.longName} sidebar={false}>

  <!-- 1. Split technical hero — editorial left, pipeline diagram right -->
  <section class="col section">
    <div style="display: grid; gap: 2.5rem; align-items: center;" class="hero-split">
      <div>
        <p class="kicker mount">Data engineering for the agent era</p>
        <h1 class="display-hero mount mount-delay-1" id="hero-headline" style="margin-top: 1.25rem;">
          {heroLines.map((line, i) => (
            <span class:list={['hero-line', i > 0 && 'hero-line-hidden']} data-hero-line={i}>{line}</span>
          ))}
        </h1>
        <p class="lede mount mount-delay-2" style="margin-top: 1.5rem;">
          An open registry and learning platform: tutorials, architecture patterns,
          agent skills, MCP servers, agents, hooks and production runbooks — each with
          provenance, license, compatibility and verification status.
        </p>
        <div class="mount mount-delay-3" style="margin-top: 2rem; display: flex; flex-wrap: wrap; gap: 0.75rem;">
          <a href="/roadmap" class="btn btn-accent btn-lg">Explore the roadmap</a>
          <a href="/marketplace" class="btn btn-lg">Browse the marketplace</a>
        </div>
      </div>
      <div class="mount mount-delay-2">
        <PipelineDiagram />
      </div>
    </div>
    <script is:inline>
      (function () {
        var lines = document.querySelectorAll('[data-hero-line]');
        var i = 0;
        function show(n) {
          lines.forEach(function (el, idx) {
            el.classList.toggle('hero-line-hidden', idx !== n);
          });
        }
        show(0);
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        setInterval(function () { i = (i + 1) % lines.length; show(i); }, 2600);
      })();
    </script>
    <style>
      .hero-line { display: block; animation: hero-fade 0.6s var(--ease-out); }
      .hero-line-hidden { display: none; }
      @keyframes hero-fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
      @media (prefers-reduced-motion: reduce) { .hero-line { animation: none; } }
      @media (min-width: 1200px) { .hero-split { grid-template-columns: minmax(0, 1fr) minmax(0, 480px); } }
    </style>
  </section>

  <hr class="hairline col" />

  <!-- 2. A day in the platform — 4 phase cards, full detail lives on /roadmap -->
  <section class="col section">
    <SectionHeader
      kicker="A day in the platform"
      title="Thirteen stages, four phases"
      lede="From Foundations to Agentic Data Engineering — the roadmap groups thirteen stages into four phases you can learn top-to-bottom."
      linkHref="/roadmap"
      linkLabel="View the roadmap"
    />
    <div class="card-grid card-grid--2 reveal" style="margin-top: 3rem;">
      {phases.map((p) => (
        <a href={`/roadmap#${p.stages[0].slug}`} class="card card-pad card-interactive" style="display: flex; flex-direction: column; gap: 0.75rem;">
          <div class="card-header" style="margin-bottom: 0;">
            <span class="mono-label">Phase {String(p.index).padStart(2, '0')}</span>
            <span class="chip">{countLabel(p.count, 'resource')}</span>
          </div>
          <h3 style="font-size: var(--text-2xl); font-weight: 500; color: var(--fg); letter-spacing: -0.01em; margin: 0.25rem 0 0;">{p.name}</h3>
          <p class="card-desc" style="flex: 1;">{p.tagline}</p>
          <ul style="display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin: 0.5rem 0 0;">
            {p.stages.map((s) => (
              <li class="chip" style="font-size: var(--text-2xs);">{String(s.order).padStart(2, '0')} · {s.title}</li>
            ))}
          </ul>
        </a>
      ))}
    </div>
    <p style="margin-top: 1.5rem;" class="text-center">
      <a class="arrow-link" href="/roadmap">All thirteen stages in full detail →</a>
    </p>
  </section>

  <hr class="hairline col" />

  <!-- 3. Learn / Build / Install / Operate -->
  <section class="col section">
    <SectionHeader
      kicker="How the platform works"
      title="Four verbs, one registry"
      lede="Everything in DE//AGENT maps to one of four moves — each backed by the same canonical data."
    />
    <div class="card-grid card-grid--2 reveal" style="margin-top: 3rem;">
      {verbs.map((v) => (
        <a href={v.href} class="card card-pad card-interactive" style="display: flex; flex-direction: column; gap: 0.6rem;">
          <p class="mono-label" style="margin: 0;">{v.label}</p>
          <p class="card-desc" style="flex: 1; margin: 0;">{v.note}</p>
          <span class="link-arrow">Go to {v.label.toLowerCase()} <span class="arrow" aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>

  <hr class="hairline col" />

  <!-- 4. Top-rated entries — derived from real composite scores -->
  <section class="col section">
    <SectionHeader
      kicker="Registry highlights"
      title="Top-rated entries"
      lede="The strongest composite scores in the registry right now — every score derives from the published scoring rubric, never editorial taste."
      linkHref="/marketplace"
      linkLabel="Browse everything"
    />
    <div class="card-grid stagger" style="margin-top: 3rem;">
      {topRated.map((r) => <ResourceCard resource={r} />)}
    </div>
  </section>


  <hr class="hairline col" />

  <!-- 4. Learn by building — starters + architectures -->
  <section class="col section">
    <SectionHeader
      kicker="Learn by building"
      title="Starters and reference architectures"
      lede="End-to-end projects you can run locally, and patterns that explain why they work."
      linkHref="/projects"
      linkLabel="All projects"
    />
    <div class="card-grid stagger" style="margin-top: 3rem;">
      {builders.map((r) => <ResourceCard resource={r} />)}
    </div>
  </section>

  <!-- 5. Trust & verification — accurate status distinctions, evidence language -->
  <section class="hairline-block">
    <div class="col section">
      <SectionHeader
        kicker="Trust, not vibes"
        title="Every claim carries evidence"
        lede="Verification levels are policy-defined. Each entry shows its provenance, license, last-checked date and known limitations — absence of evidence is rendered as absence."
        linkHref="/docs/verification"
        linkLabel="How verification works"
      />
      <div class="card-grid" style="margin-top: 2.5rem; gap: 0.75rem;">
        {[
          { label: 'community', n: byVerification.community ?? 0, note: 'Submitted with provenance; not yet reviewed.' },
          { label: 'reviewed', n: byVerification.reviewed ?? 0, note: 'Human review of source, license and claims.' },
          { label: 'tested', n: byVerification.tested ?? 0, note: 'Checks executed in isolated environments.' },
          { label: 'verified', n: byVerification.verified ?? 0, note: 'Full evidence chain on file.' },
        ].map((lvl) => (
          <div class="card card-pad-sm reveal">
            <div class="flex items-center justify-between">
              <span class="chip">{lvl.label}</span>
              <span class="font-mono text-dim" style="font-size: var(--text-lg);">{lvl.n}</span>
            </div>
            <p class="text-dim text-xs" style="margin-top: 0.5rem;">{lvl.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Install band -->
  <section class="hairline-block">
    <div class="col section" style="text-align: center;">
      <p class="kicker">Install in seconds</p>
      <h2 class="display-section" style="margin-top: 0.75rem;">One command, production-ready</h2>
      <div class="codeblock" style="max-width: 34rem; margin: 2rem auto 0; text-align: left;">
        <pre style="margin: 0; padding: 1.1rem 1.25rem; font-size: var(--text-sm); overflow-x: auto;"><code>{skill.install_command}</code></pre>
      </div>
      <div style="margin-top: 2rem; display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap;">
        <a href="/marketplace" class="btn btn-accent btn-lg">Browse the registry</a>
        <a href="/roadmap" class="btn btn-lg">Start learning <span class="arrow" aria-hidden="true"></span></a>
      </div>
    </div>
  </section>

  <!-- 7. Fresh from the registry -->
  <section class="col section">
    <SectionHeader
      kicker="Fresh from the registry"
      title="Recently updated entries"
      linkHref="/marketplace"
      linkLabel="View all"
    />
    <div class="card-grid stagger" style="margin-top: 3rem;">
      {fresh.map((r) => <ResourceCard resource={r} />)}
    </div>
  </section>

  <hr class="hairline col" />

  <!-- 8. Contribution invitation -->
  <section class="col section" style="text-align: center;">
    <p class="kicker">Contribute</p>
    <h2 class="display-section" style="margin-top: 0.75rem;">Publish your patterns</h2>
    <p class="lede" style="margin: 1.25rem auto 0; max-width: 58ch;">
      The registry grows by contribution: submit a skill, an MCP server, a runbook
      or an architecture pattern. Every submission carries its source, license and
      security posture from day one.
    </p>
    <div style="margin-top: 2rem; display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap;">
      <a href={SITE.repo} target="_blank" rel="noopener" class="btn btn-accent btn-lg">Contribute on GitHub <span aria-hidden="true">↗</span></a>
      <a href="/publisher" class="btn btn-lg">Publisher portal</a>
    </div>
  </section>

</BaseLayout>

