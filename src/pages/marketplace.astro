---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ResourceCard from '@/components/ResourceCard.astro';
import registry from '@/data/generated/registry.json';

const types = ['skill', 'mcp', 'plugin', 'agent', 'hook', 'template', 'starter', 'runbook', 'architecture', 'reference'];
const categories = registry.taxonomy.categories.filter(c => registry.resources.some(r => r.category === c.id));
const difficulties = ['beginner', 'intermediate', 'advanced'];
const verifications = ['verified', 'tested', 'reviewed', 'community'];
const agents = ['claude-code', 'codex', 'cursor', 'amp', 'gemini-cli'];

const readability = {
  read_only: registry.resources.filter(r => r.security_flags === 0).length,
  needs_credentials: registry.resources.filter(r => r.security?.credentials).length,
  network: registry.resources.filter(r => r.security?.network_access).length,
  touches_code: registry.resources.filter(r => r.security?.runs_code).length,
};

// Pre-compute filter options to avoid parser issues
const typeOptions = types.map(t => ({
  value: t,
  label: registry.resources.find(r => r.type === t)?.typeLabel ?? t,
  count: registry.resources.filter(r => r.type === t).length
}));

const categoryOptions = categories.map(c => ({
  value: c.slug,
  label: c.title,
  count: registry.resources.filter(r => r.category === c.id).length
}));

const difficultyOptions = difficulties.map(d => ({
  value: d,
  label: d,
  count: registry.resources.filter(r => r.difficulty === d).length
}));

const verificationOptions = verifications.map(v => ({
  value: v,
  label: v.charAt(0).toUpperCase() + v.slice(1),
  count: registry.resources.filter(r => r.verification === v).length
}));

const agentOptions = agents.map(a => ({
  value: a,
  label: a,
  count: registry.resources.filter(r => r.compatible_agents?.includes(a as never)).length
}));

const securityOptions = [
  { value: 'read-only', label: 'Read-only', count: readability.read_only },
  { value: 'needs-credentials', label: 'Needs credentials', count: readability.needs_credentials },
  { value: 'network', label: 'Network access', count: readability.network },
  { value: 'runs-code', label: 'Runs code', count: readability.touches_code },
];

const technologies = registry.taxonomy.technologies.filter(t => registry.resources.some(r => (r.technologies ?? []).includes(t.id)));
const stages = registry.taxonomy.stages.filter(s => registry.resources.some(r => r.stage === s.id));

const technologyOptions = technologies.map(t => ({
  value: t.id,
  label: t.name,
  count: registry.resources.filter(r => (r.technologies ?? []).includes(t.id)).length
}));

const stageOptions = stages.map(s => ({
  value: s.id,
  label: s.title,
  count: registry.resources.filter(r => r.stage === s.id).length
}));
---

<BaseLayout title="Marketplace · DE//AGENT" sidebar>
  <PageHero
    kicker="Marketplace"
    title="Browse the registry"
    lede="Filter by type, category, difficulty, verification and agent compatibility. Every entry shows its security posture — a listing is never a trust signal."
  />

  <div class="col section-sm" style="padding-top: 2.5rem;">
    <div class="grid gap-8 lg:grid-cols-[280px_1fr]">
      <!-- Filters sidebar -->
      <aside class="sticky top-16 space-y-6 self-start" style="max-height: calc(100vh - 5rem); overflow-y: auto; overscroll-behavior: contain; scrollbar-gutter: stable; padding-bottom: 1rem;">
        <details class="card card-pad-sm" open>
          <summary class="mono-label cursor-pointer">Type <span class="text-dim">({typeOptions.filter(o => o.count > 0).length})</span></summary>
          <ul class="mt-3 space-y-2">
            {typeOptions.filter(o => o.count > 0).map((opt) => (
              <li>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" name="type" value={opt.value} class="checkbox" />
                  <span class="text-sm text-muted">{opt.label}</span>
                  <span class="ml-auto font-mono text-2xs text-dim">({opt.count})</span>
                </label>
              </li>
            ))}
          </ul>
        </details>
        <details class="card card-pad-sm" open>
          <summary class="mono-label cursor-pointer">Category <span class="text-dim">({categoryOptions.filter(o => o.count > 0).length})</span></summary>
          <ul class="mt-3 space-y-2">
            {categoryOptions.filter(o => o.count > 0).map((opt) => (
              <li>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" name="category" value={opt.value} class="checkbox" />
                  <span class="text-sm text-muted">{opt.label}</span>
                  <span class="ml-auto font-mono text-2xs text-dim">({opt.count})</span>
                </label>
              </li>
            ))}
          </ul>
        </details>
        <details class="card card-pad-sm" open>
          <summary class="mono-label cursor-pointer">Difficulty <span class="text-dim">({difficultyOptions.filter(o => o.count > 0).length})</span></summary>
          <ul class="mt-3 space-y-2">
            {difficultyOptions.filter(o => o.count > 0).map((opt) => (
              <li>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" name="difficulty" value={opt.value} class="checkbox" />
                  <span class="text-sm text-muted">{opt.label}</span>
                  <span class="ml-auto font-mono text-2xs text-dim">({opt.count})</span>
                </label>
              </li>
            ))}
          </ul>
        </details>
        <details class="card card-pad-sm" open>
          <summary class="mono-label cursor-pointer">Verification <span class="text-dim">({verificationOptions.filter(o => o.count > 0).length})</span></summary>
          <ul class="mt-3 space-y-2">
            {verificationOptions.filter(o => o.count > 0).map((opt) => (
              <li>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" name="verification" value={opt.value} class="checkbox" />
                  <span class="text-sm text-muted">{opt.label}</span>
                  <span class="ml-auto font-mono text-2xs text-dim">({opt.count})</span>
                </label>
              </li>
            ))}
          </ul>
        </details>
        <details class="card card-pad-sm" open>
          <summary class="mono-label cursor-pointer">Agent Compatibility <span class="text-dim">({agentOptions.filter(o => o.count > 0).length})</span></summary>
          <ul class="mt-3 space-y-2">
            {agentOptions.filter(o => o.count > 0).map((opt) => (
              <li>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" name="agent" value={opt.value} class="checkbox" />
                  <span class="text-sm text-muted">{opt.label}</span>
                  <span class="ml-auto font-mono text-2xs text-dim">({opt.count})</span>
                </label>
              </li>
            ))}
          </ul>
        </details>
        <details class="card card-pad-sm" open>
          <summary class="mono-label cursor-pointer">Security <span class="text-dim">({securityOptions.filter(o => o.count > 0).length})</span></summary>
          <ul class="mt-3 space-y-2">
            {securityOptions.filter(o => o.count > 0).map((opt) => (
              <li>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" name="security" value={opt.value} class="checkbox" />
                  <span class="text-sm text-muted">{opt.label}</span>
                  <span class="ml-auto font-mono text-2xs text-dim">({opt.count})</span>
                </label>
              </li>
            ))}
          </ul>
        </details>
        <details class="card card-pad-sm" open>
          <summary class="mono-label cursor-pointer">Technology <span class="text-dim">({technologyOptions.filter(o => o.count > 0).length})</span></summary>
          <ul class="mt-3 space-y-2">
            {technologyOptions.filter(o => o.count > 0).map((opt) => (
              <li>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" name="technology" value={opt.value} class="checkbox" />
                  <span class="text-sm text-muted">{opt.label}</span>
                  <span class="ml-auto font-mono text-2xs text-dim">({opt.count})</span>
                </label>
              </li>
            ))}
          </ul>
        </details>
        <details class="card card-pad-sm" open>
          <summary class="mono-label cursor-pointer">Stage <span class="text-dim">({stageOptions.filter(o => o.count > 0).length})</span></summary>
          <ul class="mt-3 space-y-2">
            {stageOptions.filter(o => o.count > 0).map((opt) => (
              <li>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" name="stage" value={opt.value} class="checkbox" />
                  <span class="text-sm text-muted">{opt.label}</span>
                  <span class="ml-auto font-mono text-2xs text-dim">({opt.count})</span>
                </label>
              </li>
            ))}
          </ul>
        </details>
      </aside>

      <!-- Results grid -->
      <section>
        <div id="results" class="card-grid stagger">
          {registry.resources.filter((r) => (r.page_eligibility?.state ?? 'eligible') !== 'internal_only').map((r) => (
            <div data-type={r.type} data-category={r.categorySlug ?? ''} data-difficulty={r.difficulty ?? ''} data-verification={r.verification} data-technology={(r.technologies ?? []).join(',')} data-stage={r.stage ?? ''} data-agents={r.compatible_agents?.join(',') ?? ''} data-security={[
              r.security_flags === 0 && 'read-only',
              r.security?.credentials && 'needs-credentials',
              r.security?.network_access && 'network',
              r.security?.runs_code && 'runs-code',
            ].filter(Boolean).join(',')}>
              <ResourceCard resource={r} />
            </div>
          ))}
        </div>
        <p id="empty" class="hidden mt-8 text-center text-muted py-8">No resources match the current filters.</p>
      </section>
    </div>

    <script>
      (function () {
        const results = document.getElementById('results') as HTMLElement | null;
        const empty = document.getElementById('empty') as HTMLElement | null;
        if (!results) return;
        const cards = Array.from(results.children) as HTMLElement[];
        const checkboxes = document.querySelectorAll('aside input[type="checkbox"]') as NodeListOf<HTMLInputElement>;
        const active = new Map<string, Set<string>>();
        checkboxes.forEach((cb) => { active.set(cb.name, new Set()); });

        function apply() {
          let visible = 0;
          for (const card of cards) {
            let show = true;
            for (const [key, values] of active) {
              if (values.size === 0) continue;
              const val = card.dataset[key];
              if (!val) { show = false; break; }
              if (key === 'category' || key === 'type') {
                if (!values.has(val)) { show = false; break; }
              } else if (key === 'agent' || key === 'security' || key === 'technology') {
                const has = val.split(',').some((v: string) => values.has(v));
                if (!has) { show = false; break; }
              } else {
                if (!values.has(val)) { show = false; break; }
              }
            }
            card.hidden = !show;
            if (show) visible++;
          }
          if (empty) empty.hidden = visible > 0;
        }

        checkboxes.forEach((cb) => {
          cb.addEventListener('change', () => {
            const set = active.get(cb.name)!;
            if (cb.checked) set.add(cb.value);
            else set.delete(cb.value);
            apply();
          });
        });
      })();
    </script>
  </div>
</BaseLayout>