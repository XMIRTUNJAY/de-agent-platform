---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ResourceCard from '@/components/ResourceCard.astro';
import FilterPanel from '@/components/FilterPanel.astro';
import Icon from '@/components/Icon.astro';
import registry from '@/data/generated/registry.json';

const types = ['skill', 'mcp', 'plugin', 'agent', 'hook', 'template', 'starter', 'runbook', 'architecture', 'reference', 'policy', 'rule_pack', 'config_template', 'governance_pack'];
const categories = registry.taxonomy.categories.filter(c => registry.resources.some(r => r.category === c.id));
const difficulties = ['beginner', 'intermediate', 'advanced'];
const verifications = ['verified', 'tested', 'reviewed', 'community'];
const agents = ['claude-code', 'codex', 'cursor', 'amp', 'gemini-cli'];
const compositeLabels = ['exemplary', 'strong', 'adequate', 'weak', 'unproven'];

const readability = {
  read_only: registry.resources.filter(r => r.security_flags === 0).length,
  needs_credentials: registry.resources.filter(r => r.security?.credentials).length,
  network: registry.resources.filter(r => r.security?.network_access).length,
  touches_code: registry.resources.filter(r => r.security?.runs_code).length,
};

// Pre-compute filter options to avoid parser issues
const typeOptions = types.map(t => ({
  value: t,
  label: registry.resources.find(r => r.type === t)?.typeLabel ?? t,
  count: registry.resources.filter(r => r.type === t).length
}));

const categoryOptions = categories.map(c => ({
  value: c.slug,
  label: c.title,
  count: registry.resources.filter(r => r.category === c.id).length
}));

const difficultyOptions = difficulties.map(d => ({
  value: d,
  label: d,
  count: registry.resources.filter(r => r.difficulty === d).length
}));

const verificationOptions = verifications.map(v => ({
  value: v,
  label: v.charAt(0).toUpperCase() + v.slice(1),
  count: registry.resources.filter(r => r.verification === v).length
}));

const agentOptions = agents.map(a => ({
  value: a,
  label: a,
  count: registry.resources.filter(r => r.compatible_agents?.includes(a as never)).length
}));

const securityOptions = [
  { value: 'read-only', label: 'Read-only', count: readability.read_only },
  { value: 'needs-credentials', label: 'Needs credentials', count: readability.needs_credentials },
  { value: 'network', label: 'Network access', count: readability.network },
  { value: 'runs-code', label: 'Runs code', count: readability.touches_code },
];

const compositeLabelOptions = compositeLabels.map(l => ({
  value: l,
  label: l.charAt(0).toUpperCase() + l.slice(1),
  count: registry.resources.filter(r => r.marketplace?.composite_label === l).length
}));

const technologies = registry.taxonomy.technologies.filter(t => registry.resources.some(r => ((r.technologies ?? []) as string[]).includes(t.id)));
const stages = registry.taxonomy.stages.filter(s => registry.resources.some(r => r.stage === s.id));

const technologyOptions = technologies.map(t => ({
  value: t.id,
  label: t.name,
  count: registry.resources.filter(r => ((r.technologies ?? []) as string[]).includes(t.id)).length
}));

const stageOptions = stages.map(s => ({
  value: s.id,
  label: s.title,
  count: registry.resources.filter(r => r.stage === s.id).length
}));

// Single source for FilterPanel — key order matches filter-state.mjs.
const filters = [
  { label: 'Type', key: 'type', options: typeOptions },
  { label: 'Category', key: 'category', options: categoryOptions },
  { label: 'Difficulty', key: 'difficulty', options: difficultyOptions },
  { label: 'Verification', key: 'verification', options: verificationOptions },
  { label: 'Agent Compatibility', key: 'agent', options: agentOptions },
  { label: 'Security', key: 'security', options: securityOptions },
  { label: 'Technology', key: 'technology', options: technologyOptions },
  { label: 'Stage', key: 'stage', options: stageOptions },
  { label: 'Quality Score', key: 'quality', options: compositeLabelOptions },
];
---

<BaseLayout title="Marketplace · DE//AGENT" sidebar>
  <PageHero
    kicker="Marketplace"
    title="Browse the registry"
    lede="Filter by type, category, difficulty, verification and agent compatibility. Every entry shows its security posture — a listing is never a trust signal."
  />

  <div class="col section-sm" style="padding-top: 2.5rem;">
    <div class="grid gap-8 min-[1200px]:grid-cols-[280px_1fr]">
      <!-- Filters sidebar -->
      <button type="button" data-filter-toggle class="btn btn-sm mb-4 gap-2 lg:hidden" aria-expanded="false" aria-controls="filters">
        <Icon name="categories" size={14} /> Filters
      </button>
      <FilterPanel filters={filters} id="filters" />

      <!-- Results grid -->
      <section>
        <div class="flex items-center gap-4 mb-4 flex-wrap">
          <label class="flex items-center gap-2" style="white-space: nowrap;">
            <span class="text-sm text-muted">Sort by:</span>
            <select id="sort-select" class="select select-sm">
              <option value="composite-desc">Quality Score ↓</option>
              <option value="rating-desc">Rating ↓</option>
              <option value="installs-desc">Installs ↓</option>
              <option value="updated-desc">Recently Updated</option>
              <option value="verification-desc">Verification Level</option>
            </select>
          </label>
          <p id="result-count" class="ml-auto font-mono text-2xs text-dim" style="margin: 0; white-space: nowrap;"></p>
        </div>
        <div id="active-chips" class="filter-chips" hidden></div>
        <div id="results" class="card-grid stagger">
          {registry.resources.filter((r) => (r.page_eligibility?.state ?? 'eligible') !== 'internal_only').map((r) => (
            <div
              data-type={r.type}
              data-category={r.categorySlug ?? ''}
              data-difficulty={r.difficulty ?? ''}
              data-verification={r.verification}
              data-technology={(r.technologies ?? []).join(',')}
              data-stage={r.stage ?? ''}
              data-agent={r.compatible_agents?.join(',') ?? ''}
              data-composite={r.marketplace?.composite_score ?? 0}
              data-rating={r.marketplace?.rating_average ?? 0}
              data-installs={r.marketplace?.install_count ?? 0}
              data-updated={r.last_verified || r.freshness?.pushed_at || ''}
              data-quality={r.marketplace?.composite_label ?? ''}
              data-security={[
                r.security_flags === 0 && 'read-only',
                r.security?.credentials && 'needs-credentials',
                r.security?.network_access && 'network',
                r.security?.runs_code && 'runs-code',
              ].filter(Boolean).join(',')}
            >
              <ResourceCard resource={r} />
            </div>
          ))}
        </div>
        <p id="empty" class="hidden mt-8 text-center text-muted py-8">No resources match the current filters.</p>
      </section>
    </div>

    <script>
      import {
        stateFromParams,
        paramsFromState,
        activeCount,
        chipList,
        withoutChip,
        DEFAULT_SORT,
      } from '@/lib/filter-state.mjs';

      (function () {
        const results = document.getElementById('results') as HTMLElement | null;
        const empty = document.getElementById('empty') as HTMLElement | null;
        if (!results) return;
        const cards = Array.from(results.children) as HTMLElement[];
        const panel = document.getElementById('filters') as HTMLElement | null;
        const checkboxes = document.querySelectorAll('#filters input[type="checkbox"]') as NodeListOf<HTMLInputElement>;
        const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
        const chipsRow = document.getElementById('active-chips') as HTMLElement | null;
        const countEl = document.getElementById('result-count') as HTMLElement | null;
        const filterCount = panel?.querySelector('[data-filter-count]') as HTMLElement | null;
        const scrim = document.getElementById('sidebar-scrim');
        const toggleBtn = document.querySelector('[data-filter-toggle]') as HTMLButtonElement | null;
        const closeBtn = panel?.querySelector('[data-filter-close]') as HTMLButtonElement | null;
        const clearBtn = panel?.querySelector('[data-filter-clear]') as HTMLButtonElement | null;

        let state = stateFromParams(new URLSearchParams(location.search)) as Record<string, string[]>;
        let currentSort = sortSelect?.value ?? DEFAULT_SORT;
        const urlSort = new URLSearchParams(location.search).get('sort');
        if (urlSort && sortSelect) sortSelect.value = urlSort;
        currentSort = sortSelect?.value ?? DEFAULT_SORT;

        function syncCheckboxes() {
          checkboxes.forEach((cb) => {
            cb.checked = (state[cb.name] ?? []).includes(cb.value);
          });
        }

        function closeDrawer() {
          if (!panel || !panel.classList.contains('open')) return;
          panel.classList.remove('open');
          scrim?.classList.remove('show');
          toggleBtn?.setAttribute('aria-expanded', 'false');
        }

        function apply(pushUrl: boolean) {
          syncCheckboxes();

          let visible = 0;
          for (const card of cards) {
            let show = true;
            for (const [key, values] of Object.entries(state)) {
              if (!values || values.length === 0) continue;
              const val = card.dataset[key];
              if (!val) { show = false; break; }
              if (key === 'agent' || key === 'security' || key === 'technology' || key === 'quality') {
                if (!val.split(',').some((v) => values.includes(v))) { show = false; break; }
              } else if (!values.includes(val)) {
                show = false;
                break;
              }
            }
            card.hidden = !show;
            if (show) visible++;
          }

          const visibleCards = cards.filter((c) => !c.hidden);
          const num = (el: HTMLElement, k: string) => Number.parseFloat(el.dataset[k] ?? '0') || 0;
          visibleCards.sort((a, b) => {
            switch (currentSort) {
              case 'rating-desc': return num(b, 'rating') - num(a, 'rating');
              case 'installs-desc': return num(b, 'installs') - num(a, 'installs');
              case 'updated-desc':
                return new Date(b.dataset.updated ?? 0).getTime() - new Date(a.dataset.updated ?? 0).getTime();
              case 'verification-desc': {
                const rank: Record<string, number> = { verified: 4, tested: 3, reviewed: 2, community: 1 };
                return (rank[b.dataset.verification ?? ''] ?? 0) - (rank[a.dataset.verification ?? ''] ?? 0);
              }
              default: return num(b, 'composite') - num(a, 'composite');
            }
          });
          visibleCards.forEach((c) => results!.appendChild(c));

          if (empty) empty.hidden = visible > 0;
          if (countEl) countEl.textContent = `${visible} resource${visible === 1 ? '' : 's'}`;

          // Active-filter chips
          const count = activeCount(state);
          if (filterCount) {
            filterCount.textContent = String(count);
            filterCount.hidden = count === 0;
          }
          if (chipsRow) {
            chipsRow.hidden = count === 0;
            chipsRow.innerHTML = '';
            for (const chip of chipList(state)) {
              const el = document.createElement('span');
              el.className = 'filter-chip';
              el.append(`${chip.key}: ${chip.value}`);
              const x = document.createElement('button');
              x.type = 'button';
              x.setAttribute('aria-label', `Remove filter ${chip.key}: ${chip.value}`);
              x.textContent = '\u00d7';
              x.addEventListener('click', () => {
                state = withoutChip(state, chip.key, chip.value);
                apply(true);
              });
              el.appendChild(x);
              chipsRow.appendChild(el);
            }
          }

          // URL sync — replaceState for direct edits, push for popstate replay
          const params = paramsFromState(state, currentSort);
          const qs = params.toString();
          const url = `${location.pathname}${qs ? `?${qs}` : ''}`;
          if (pushUrl) history.pushState(state, '', url);
          else history.replaceState(state, '', url);
        }

        checkboxes.forEach((cb) => {
          cb.addEventListener('change', () => {
            const values = state[cb.name] ? [...state[cb.name]] : [];
            const idx = values.indexOf(cb.value);
            if (cb.checked && idx === -1) values.push(cb.value);
            if (!cb.checked && idx !== -1) values.splice(idx, 1);
            if (values.length) state[cb.name] = values;
            else delete state[cb.name];
            apply(true);
          });
        });

        sortSelect?.addEventListener('change', () => {
          currentSort = sortSelect.value;
          apply(true);
        });

        clearBtn?.addEventListener('click', () => {
          state = {};
          apply(true);
        });

        toggleBtn?.addEventListener('click', () => {
          if (!panel) return;
          const open = !panel.classList.contains('open');
          panel.classList.toggle('open', open);
          scrim?.classList.toggle('show', open);
          toggleBtn.setAttribute('aria-expanded', String(open));
          if (open) (panel.querySelector('input, button, summary') as HTMLElement | null)?.focus();
        });
        closeBtn?.addEventListener('click', closeDrawer);
        scrim?.addEventListener('click', closeDrawer);
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeDrawer();
        });
        window.addEventListener('popstate', () => {
          state = stateFromParams(new URLSearchParams(location.search)) as Record<string, string[]>;
          const urlSort = new URLSearchParams(location.search).get('sort');
          if (sortSelect) sortSelect.value = urlSort ?? DEFAULT_SORT;
          currentSort = sortSelect?.value ?? DEFAULT_SORT;
          apply(false);
        });

        apply(false);
      })();
    </script>
  </div>
</BaseLayout>