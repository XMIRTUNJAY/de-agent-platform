---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import FilterPanel from '@/components/FilterPanel.astro';
import ResourceCard from '@/components/ResourceCard.astro';
import registry from '@/data/generated/registry.json';
import { count as countLabel } from '@/lib/format';

const cat = registry.taxonomy.categories.find(c => c.slug === Astro.params.slug);
if (!cat) throw new Error('Category not found');

// Grounded, human-editable overviews generated by pipelines/audit-content.mjs
// (--categories) from registry fields only — never invented copy. Edits to
// these JSON files are preserved by the generator unless --force is passed.
const overviewFiles = import.meta.glob('../../data/enrichment/categories/*.json', { eager: true }) as Record<string, { slug: string; intro: string; startHere: { title: string; url: string; composite: number }[]; related?: { title: string; slug: string; n: number }[] }>;
const overview = Object.values(overviewFiles).find((o) => o.slug === cat.slug);

const resources = registry.resources.filter(r => r.category === cat.id);
const types = [...new Set(resources.map(r => r.type))].sort();
const difficulties = ['beginner', 'intermediate', 'advanced'];
const verifications = ['verified', 'tested', 'reviewed', 'community'];

const filters = [
  { label: 'Type', key: 'type', options: types.map(t => ({ value: t, label: registry.resources.find(r => r.type === t)?.typeLabel ?? t, count: resources.filter(r => r.type === t).length })) },
  { label: 'Difficulty', key: 'difficulty', options: difficulties.map(d => ({ value: d, label: d, count: resources.filter(r => r.difficulty === d).length })) },
  { label: 'Verification', key: 'verification', options: verifications.map(v => ({ value: v, label: v.charAt(0).toUpperCase() + v.slice(1), count: resources.filter(r => r.verification === v).length })) },
  { label: 'Technology', key: 'technology', options: [...new Set(resources.flatMap(r => r.technologies ?? []))].sort().map(t => ({ value: t, label: registry.taxonomy.technologies.find(x => x.id === t)?.name ?? t, count: resources.filter(r => ((r.technologies ?? []) as string[]).includes(t)).length })) },
  { label: 'Stage', key: 'stage', options: [...new Set(resources.map(r => r.stage).filter(Boolean))].sort().map(s => ({ value: s, label: registry.taxonomy.stages.find(x => x.id === s)?.title ?? s, count: resources.filter(r => r.stage === s).length })) },
];

export async function getStaticPaths() {
  return registry.taxonomy.categories.map(c => ({ params: { slug: c.slug } }));
}
---

<BaseLayout title={cat.title} sidebar>
  <PageHero kicker={cat.group} title={cat.title} lede={cat.summary}>
    <div style="margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem;">
      <span class="chip">{countLabel(resources.length, 'resource')}</span>
      <span class="chip">{types.length} types</span>
    </div>
  </PageHero>

    {overview?.intro && (
      <div class="col" style="max-width: 72ch; margin-top: 2rem;">
        <p class="mono-label">Inside this category</p>
        <p style="margin-top: 0.6rem; color: var(--fg-muted); line-height: 1.7;">{overview.intro}</p>
        {overview.startHere.length > 0 && (
          <p style="margin-top: 0.75rem; font-size: var(--text-sm);">
            <span style="color: var(--fg); font-weight: 600;">Where to start: </span>
            {overview.startHere.map((s, i) => (
              <>
                {i > 0 && ', '}
                <a href={s.url} style="color: var(--fg);">{s.title}</a>
                <span class="text-dim text-xs"> ({s.composite})</span>
              </>
            ))}
          </p>
        )}
      </div>
    )}
    <hr class="hairline col" style="margin-block: 2.5rem;" />

    <div class="col section-sm" style="padding-top: 0;">
    {resources.filter((r) => (r.page_eligibility?.state ?? 'eligible') !== 'internal_only').length === 0 ? (
      <div class="empty-state" style="border: 1px dashed var(--border); border-radius: var(--radius-md); padding: 2.5rem 1.5rem; text-align: center;">
        <p style="font-weight: 600; color: var(--fg);">No resources yet</p>
        <p class="text-muted" style="margin-top: 0.4rem; font-size: var(--text-sm);">
          This part of the taxonomy is defined but unfilled. Curation adds entries by evidence-first review — nothing is padded with placeholder tools.
        </p>
        {overview?.related && overview.related.length > 0 && (
          <p style="margin-top: 1rem; font-size: var(--text-sm);">
            <span class="text-muted">Closest filled categories: </span>
            {overview.related.map((r2, i) => (
              <>
                {i > 0 && ', '}
                <a href={`/categories/${r2.slug}`}>{r2.title}</a>
                <span class="text-dim text-xs"> ({r2.n})</span>
              </>
            ))}
          </p>
        )}
        <p style="margin-top: 1rem;"><a href="/marketplace" class="btn btn-sm">Browse the full registry</a></p>
      </div>
    ) : (
    <div class="grid gap-8 min-[1200px]:grid-cols-[280px_1fr]">
      <button type="button" data-filter-toggle class="btn btn-sm mb-4 gap-2 lg:hidden" aria-expanded="false" aria-controls="filters">
        Filters
      </button>
      <FilterPanel filters={filters} id="filters" />

      <section>
        <div id="results" class="card-grid">
          {resources.filter((r) => (r.page_eligibility?.state ?? 'eligible') !== 'internal_only').map((r) => (
            <div data-type={r.type} data-difficulty={r.difficulty ?? ''} data-verification={r.verification} data-technology={(r.technologies ?? []).join(',')} data-stage={r.stage ?? ''}>
              <ResourceCard resource={r} />
            </div>
          ))}
        </div>
      </section>
    </div>
    )}
  </div>

    <script>
      (function () {
        const results = document.getElementById('results') as HTMLElement | null;
        if (!results) return;
        const cards = Array.from(results.children) as HTMLElement[];
        const checkboxes = document.querySelectorAll('aside input[type="checkbox"]') as NodeListOf<HTMLInputElement>;
        const active = new Map<string, Set<string>>();
        checkboxes.forEach((cb) => { active.set(cb.name, new Set()); });

        function apply() {
          for (const card of cards) {
            let show = true;
            for (const [key, values] of active) {
              if (values.size === 0) continue;
              const val = card.dataset[key];
              if (!val) { show = false; break; }
              if (key === 'technology') {
                const has = val.split(',').some((v: string) => values.has(v));
                if (!has) { show = false; break; }
              } else {
                if (!values.has(val)) { show = false; break; }
              }
            }
            card.hidden = !show;
          }
        }

        checkboxes.forEach((cb) => {
          cb.addEventListener('change', () => {
            const set = active.get(cb.name)!;
            if (cb.checked) set.add(cb.value);
            else set.delete(cb.value);
            apply();
          });
        });

        const panel = document.getElementById('filters');
        const toggleBtn = document.querySelector('[data-filter-toggle]') as HTMLButtonElement | null;
        const closeBtn = panel?.querySelector('[data-filter-close]') as HTMLButtonElement | null;
        const scrim = document.getElementById('sidebar-scrim');
        toggleBtn?.addEventListener('click', () => {
          if (!panel) return;
          const open = !panel.classList.contains('open');
          panel.classList.toggle('open', open);
          scrim?.classList.toggle('show', open);
          toggleBtn.setAttribute('aria-expanded', String(open));
        });
        closeBtn?.addEventListener('click', () => {
          panel?.classList.remove('open');
          scrim?.classList.remove('show');
          toggleBtn?.setAttribute('aria-expanded', 'false');
        });
        scrim?.addEventListener('click', () => {
          panel?.classList.remove('open');
          scrim?.classList.remove('show');
          toggleBtn?.setAttribute('aria-expanded', 'false');
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && panel?.classList.contains('open')) {
            panel.classList.remove('open');
            scrim?.classList.remove('show');
            toggleBtn?.setAttribute('aria-expanded', 'false');
          }
        });
      })();
    </script>
</BaseLayout>
