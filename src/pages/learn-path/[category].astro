---
// /learn-path/[category] — guided progression through a category (38 pages).
import BaseLayout from '@/layouts/BaseLayout.astro';
import registry from '@/data/generated/registry.json';
import { buildLearnPath } from '../../../pipelines/lib/stage-compare.mjs';

export async function getStaticPaths() {
  return (registry.taxonomy.categories ?? []).map((c: any) => ({ params: { category: c.slug } }));
}
const { category } = Astro.params;
const page = buildLearnPath(category, registry) as any;
if (!page) return Astro.redirect('/roadmap');
---

<BaseLayout title={`${page.title} — guided learning path`} description={`${page.lede}. Sequenced by roadmap stage and score, with prerequisites, objectives and cautions — from the DE//AGENT registry.`}>
  <section class="col section-sm" style="padding-top: 2.5rem; max-width: 76ch;">
    <p class="kicker">Learning path</p>
    <h1 style="font-size: var(--text-2xl); font-weight: 500; margin-top: 0.5rem;">{page.title}</h1>
    <p class="text-dim font-mono text-sm" style="margin-top: 0.4rem;">{page.lede}</p>
    {page.sections.map((s: any) => (
      <section id={s.id} style="margin-top: 2.25rem;">
        <h2 style="font-size: var(--text-xl); font-weight: 500;">{s.title}</h2>
        <div class="prose-de" style="margin-top: 0.6rem;" set:html={s.html} />
      </section>
    ))}
    <p style="margin-top: 2rem;"><a href="/roadmap" class="link">← Roadmap</a> · <a href="/learn" class="link">All topics</a></p>
  </section>
</BaseLayout>
