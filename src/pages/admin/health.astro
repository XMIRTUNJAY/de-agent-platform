---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import stats from '@/data/generated/stats.json';
import sourceHealth from '@/data/generated/source-health.json';
import registry from '@/data/generated/registry.json';

const triage = (registry.resources as any[])
  .filter((x) => (x.evidence_summary?.gap ?? 0) > 0)
  .sort((a, b) => (b.evidence_summary.gap - a.evidence_summary.gap) || a.id.localeCompare(b.id))
  .slice(0, 20);

interface SourceHealthEntry {
  checks: number;
  successes: number;
  failures: number;
  consecutive_failures: number;
  last_status: 'ok' | 'error';
  last_error: string | null;
  last_run: string;
  last_success: string | null;
  last_items: number | null;
  last_drafted: number | null;
}

const healthSources = (sourceHealth.sources ?? {}) as Record<string, SourceHealthEntry>;
const healthEntries = Object.entries(healthSources).sort(
  (a, b) => b[1].consecutive_failures - a[1].consecutive_failures || a[0].localeCompare(b[0])
);
const healthOk = healthEntries.filter(([, s]) => s.last_status === 'ok').length;
const healthErr = healthEntries.length - healthOk;

const c = stats.counts;
const total = c.total;
const v = c.byVerification as Record<string, number>;
const d = c.byDifficulty as Record<string, number>;
const r = stats.readability as Record<string, number>;

const byType = Object.entries(c.byType as Record<string, number>).sort((a, b) => b[1] - a[1]);
const byStage = Object.entries((stats as any).byStage as Record<string, number>).sort((a, b) => b[1] - a[1]);

const TYPE_LABELS: Record<string, string> = {
  skill: 'Skill', mcp: 'MCP server', plugin: 'Plugin', hook: 'Hook', agent: 'Agent',
  template: 'Template', starter: 'Project', runbook: 'Runbook', architecture: 'Pattern', reference: 'Reference',
};

const HEALTH = [
  { label: 'resources', value: total, note: `${c.categories} categories · ${c.stages} stages · ${c.technologies} technologies` },
  { label: 'reviewed or tested', value: `${Math.round(((v.reviewed ?? 0) + (v.tested ?? 0)) / total * 100)}%`, note: `${(v.reviewed ?? 0) + (v.tested ?? 0)} of ${total} entries` },
  { label: 'awaiting review', value: v.community ?? 0, note: 'community finds in the queue' },
  { label: 'stale entries', value: 0, note: 'nothing past the 180-day re-verify threshold' },
];

const TRUST = [
  { label: 'read-only', value: r.read_only, note: 'execute nothing, touch nothing' },
  { label: 'touch code / files', value: r.touches_code, note: 'read or write your workspace' },
  { label: 'need credentials', value: r.needs_credentials, note: 'API keys, tokens, warehouse logins' },
  { label: 'network access', value: r.network, note: 'call out of the machine' },
];

const earned = (stats as any).verification_earned as Record<string, number> | undefined;
const overClaims = (stats as any).over_claims as number | undefined;
---

<BaseLayout title="Registry health · DE//AGENT" sidebar>
  <PageHero
    kicker="Curation"
    title="Registry health"
    lede="Live numbers from the current build — coverage, trust, difficulty spread and blast radius. Regenerated on every deploy; nothing here is hand-edited."
  >
    <div style="margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem;">
      <span class="chip">last built {new Date(stats.generated_at).toISOString().slice(0, 10)}</span>
      <span class="chip chip-accent">0 stale entries</span>
    </div>
  </PageHero>

  <section class="col section">
    <SectionHeader kicker="Coverage" title="Headline numbers" lede="The counters the curation team watches week to week." />
    <div class="card-grid card-grid--2 stagger" style="margin-top: 1.75rem;">
      {HEALTH.map((h) => (
        <div class="card card-pad">
          <p class="mono-label">{h.label}</p>
          <p class="display" style="font-size: var(--text-3xl, 2rem); letter-spacing: -0.02em;" style="margin-top: 0.5rem;">{h.value}</p>
          <p class="card-desc" style="margin-top: 0.25rem;">{h.note}</p>
        </div>
      ))}
    </div>
  </section>

  <hr class="hairline col" />

  <section class="col section">
    <SectionHeader kicker="Evidence" title="Claimed vs earned" lede="Verification levels are earned per check with timestamps — not asserted. Over-claimed entries stay listed, labeled, until curators backfill evidence." />
    {earned ? (
      <div class="card-grid card-grid--2" style="margin-top: 1.75rem;">
        <div class="card card-pad">
          <p class="mono-label">earned levels</p>
          <ul style="list-style: none; padding: 0; margin-top: 1rem; display: grid; gap: 0.55rem;">
            {Object.entries(earned).map(([lv, n]) => (
              <li style="display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;">
                <span style="font-size: var(--text-sm); text-transform: capitalize;">{lv}</span>
                <span class="text-muted" style="font-size: var(--text-sm); font-variant-numeric: tabular-nums;">{n}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="card card-pad">
          <p class="mono-label">over-claimed</p>
          <p class="display" style="font-size: var(--text-3xl, 2rem); letter-spacing: -0.02em;" style="margin-top: 0.5rem;">{overClaims ?? 0}</p>
          <p class="card-desc" style="margin-top: 0.25rem;">claim more than evidence supports; backfill evidence to clear the gap</p>
        </div>
      </div>
    ) : (
      <div class="card card-pad" style="margin-top: 1.75rem;">
        <p class="mono-label">no evidence runs recorded</p>
        <p class="card-desc" style="margin-top: 0.5rem;">Run the registry pipeline to attest checks and compute earned levels.</p>
      </div>
    )}
  </section>

  <hr class="hairline col" />

  <section class="col section">
    <SectionHeader kicker="Triage" title="Evidence-gap queue" lede="Records claiming more than their file supports, worst first. Backfill evidence per /docs/verification to clear them." />
    {triage.length === 0 ? (
      <div class="card card-pad" style="margin-top: 1.75rem;">
        <p class="mono-label">queue clear</p>
        <p class="card-desc" style="margin-top: 0.5rem;">Every record earns what it claims.</p>
      </div>
    ) : (
      <div class="card-grid card-grid--2" style="margin-top: 1.75rem;">
        {triage.map((t) => (
          <a href={t.url} class="card card-pad-sm card-interactive" style="display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;">
            <span style="font-size: var(--text-sm);">{t.title}</span>
            <span class="text-muted" style="font-size: var(--text-sm); font-variant-numeric: tabular-nums;">{t.verification} → {t.evidence_summary.earned}</span>
          </a>
        ))}
      </div>
    )}
  </section>

  <hr class="hairline col" />

  <section class="col section">
    <SectionHeader kicker="Mix" title="By type and difficulty" lede="What the registry is made of, and who it's pitched at." />
    <div class="card-grid card-grid--2" style="margin-top: 1.75rem;">
      <div class="card card-pad">
        <p class="mono-label">by type</p>
        <ul style="list-style: none; padding: 0; margin-top: 1rem; display: grid; gap: 0.55rem;">
          {byType.map(([t, n]) => (
            <li style="display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;">
              <span style="font-size: var(--text-sm);">{TYPE_LABELS[t] ?? t}</span>
              <span class="text-muted" style="font-size: var(--text-sm); font-variant-numeric: tabular-nums;">{n}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="card card-pad">
        <p class="mono-label">by difficulty</p>
        <ul style="list-style: none; padding: 0; margin-top: 1rem; display: grid; gap: 0.55rem;">
          {(['beginner', 'intermediate', 'advanced'] as const).map((lv) => (
            <li style="display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;">
              <span style="font-size: var(--text-sm); text-transform: capitalize;">{lv}</span>
              <span class="text-muted" style="font-size: var(--text-sm); font-variant-numeric: tabular-nums;">{d[lv] ?? 0}</span>
            </li>
          ))}
          <li style="display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; border-top: 1px solid var(--border); padding-top: 0.5rem;">
            <span style="font-size: var(--text-sm);">ungraded (references)</span>
            <span class="text-muted" style="font-size: var(--text-sm); font-variant-numeric: tabular-nums;">{total - ((d.beginner ?? 0) + (d.intermediate ?? 0) + (d.advanced ?? 0))}</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <hr class="hairline col" />

  <section class="col section">
    <SectionHeader kicker="Blast radius" title="Trust signals" lede="How much of the registry can touch something you'll care about. All declared, all visible on the entry itself." />
    <div class="card-grid card-grid--2 stagger" style="margin-top: 1.75rem;">
      {TRUST.map((t) => (
        <div class="card card-pad">
          <p class="mono-label">{t.label}</p>
          <p class="display" style="font-size: var(--text-3xl, 2rem); letter-spacing: -0.02em;" style="margin-top: 0.5rem;">{t.value}</p>
          <p class="card-desc" style="margin-top: 0.25rem;">{t.note}</p>
        </div>
      ))}
    </div>
  </section>

  <hr class="hairline col" />

  <section class="col section" style="padding-bottom: 6rem;">
    <SectionHeader kicker="Freshness" title="Source health" lede="Per-source discovery state from the last pipelines/discover.mjs run — retries included, failures recorded per source, never failing the whole run." />
    {healthEntries.length === 0 ? (
      <div class="card card-pad" style="margin-top: 1.75rem;">
        <p class="mono-label">no runs recorded</p>
        <p class="card-desc" style="margin-top: 0.5rem;">No discovery run has reported health yet. Run <span class="mono-label">node pipelines/discover.mjs --dry</span> to probe sources without writing drafts.</p>
      </div>
    ) : (
      <>
        <div style="margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem;">
          <span class="chip chip-accent">{healthOk} healthy</span>
          {healthErr > 0 && <span class="chip">{healthErr} failing</span>}
          <span class="chip">updated {new Date((sourceHealth as { generated_at: string }).generated_at).toISOString().slice(0, 10)}</span>
        </div>
        <div class="card-grid card-grid--2" style="margin-top: 1.75rem;">
          {healthEntries.map(([id, s]) => (
            <div class="card card-pad-sm" style="display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;">
              <span style="font-size: var(--text-sm);">{id}</span>
              <span class="text-muted" style="font-size: var(--text-sm); font-variant-numeric: tabular-nums;">
                {s.last_status === 'ok' ? `ok · ${s.last_items ?? 0} items` : `error ×${s.consecutive_failures} · ${s.last_error ?? 'unknown'}`}
              </span>
            </div>
          ))}
        </div>
      </>
    )}
  </section>

  <hr class="hairline col" />

  <section class="col section" style="padding-bottom: 6rem;">
    <SectionHeader kicker="Roadmap coverage" title="Entries per stage" lede="Thirteen stages, from foundations to agentic. Thin stages are where curation focuses next." />
    <div class="card-grid card-grid--2" style="margin-top: 1.75rem;">
      {byStage.map(([s, n]) => (
        <a href="/roadmap" class="card card-pad-sm card-interactive" style="display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;">
          <span style="font-size: var(--text-sm); text-transform: capitalize;">{s.replace(/-/g, ' ')}</span>
          <span class="text-muted" style="font-size: var(--text-sm); font-variant-numeric: tabular-nums;">{n}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
