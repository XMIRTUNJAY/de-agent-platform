# Analytics
PUBLIC_ANALYTICS_ENABLED=true
PUBLIC_ANALYTICS_ENDPOINT=/api/analytics/collect

# Ratings + engagement DB (libsql/SQLite-wire).
# Local dev: omit both -> file:.data/votes.db (gitignored).
# Vercel prod: set both (Turso). better-sqlite3 cannot persist on serverless.
# TURSO_DATABASE_URL=libsql://xxx.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...
# Salt for voter/ip hashes (set a long random value in prod).
# VOTE_SALT=change-me

# Optional: Plausible/Umami (if switching providers)
# PUBLIC_PLAUSIBLE_DOMAIN=de-agent-platform.vercel.app
# PUBLIC_UMAMI_WEBSITE_ID=xxx

# Optional: Stripe (for team workspaces)
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_TEAM_MONTHLY=price_xxx